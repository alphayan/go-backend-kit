package auth

import (
	"testing"
	"time"

	"github.com/go-jose/go-jose/v4"
	"github.com/go-jose/go-jose/v4/jwt"
)

func TestVerifierAcceptsValidToken(t *testing.T) {
	secret := testSecret()
	verifier := mustVerifier(t, secret)
	raw := mustSign(t, secret, jose.HS256, jwt.Claims{
		Issuer:   "test-issuer",
		Subject:  "user-1",
		Audience: jwt.Audience{"test-audience"},
		Expiry:   jwt.NewNumericDate(time.Now().Add(time.Minute)),
		IssuedAt: jwt.NewNumericDate(time.Now()),
	})
	identity, err := verifier.Verify(raw)
	if err != nil {
		t.Fatal(err)
	}
	if identity.Subject != "user-1" {
		t.Fatalf("subject = %q", identity.Subject)
	}
}

func TestVerifierRejectsInvalidTokens(t *testing.T) {
	secret := testSecret()
	verifier := mustVerifier(t, secret)
	other := append([]byte(nil), secret...)
	other[0]++
	tests := map[string]string{
		"missing":    "",
		"malformed":  "not-a-jwt",
		"wrong alg":  mustSignAlg(t, secret, jose.HS384),
		"bad sig":    mustSign(t, other, jose.HS256, validClaims(time.Now().Add(time.Minute))),
		"expired":    mustSign(t, secret, jose.HS256, validClaims(time.Now().Add(-time.Minute))),
		"wrong iss":  mustSign(t, secret, jose.HS256, claims("other-issuer", "test-audience", "user-1", time.Now().Add(time.Minute))),
		"wrong aud":  mustSign(t, secret, jose.HS256, claims("test-issuer", "other-audience", "user-1", time.Now().Add(time.Minute))),
		"missing sub": mustSign(t, secret, jose.HS256, claims("test-issuer", "test-audience", "", time.Now().Add(time.Minute))),
		"missing exp": mustSign(t, secret, jose.HS256, claimsWithoutExpiry()),
	}
	for name, raw := range tests {
		t.Run(name, func(t *testing.T) {
			identity, err := verifier.Verify(raw)
			if err == nil {
				t.Fatalf("accepted token, identity = %+v", identity)
			}
			if identity.Subject != "" {
				t.Fatalf("leaked identity on failure: %+v", identity)
			}
			if err.Error() != "unauthorized" {
				t.Fatalf("error = %v", err)
			}
		})
	}
}

func TestVerifierRejectsNotBefore(t *testing.T) {
	secret := testSecret()
	verifier := mustVerifier(t, secret)
	claims := validClaims(time.Now().Add(time.Minute))
	claims.NotBefore = jwt.NewNumericDate(time.Now().Add(time.Hour))
	raw := mustSign(t, secret, jose.HS256, claims)
	if _, err := verifier.Verify(raw); err == nil {
		t.Fatal("accepted not-before token")
	}
}

func TestNewVerifierRejectsInvalidConfig(t *testing.T) {
	secret := testSecret()
	tests := []struct {
		name     string
		secret   []byte
		issuer   string
		audience string
		leeway   time.Duration
	}{
		{"short secret", secret[:31], "test-issuer", "test-audience", 30 * time.Second},
		{"missing issuer", secret, "", "test-audience", 30 * time.Second},
		{"missing audience", secret, "test-issuer", "", 30 * time.Second},
		{"leeway too large", secret, "test-issuer", "test-audience", 3 * time.Minute},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			if _, err := NewVerifier(test.secret, test.issuer, test.audience, test.leeway); err == nil {
				t.Fatal("accepted invalid verifier config")
			}
		})
	}
}

func TestIdentityContextRoundTrip(t *testing.T) {
	ctx := WithIdentity(t.Context(), Identity{Subject: "user-1"})
	got, ok := IdentityFrom(ctx)
	if !ok || got.Subject != "user-1" {
		t.Fatalf("identity = %+v ok=%v", got, ok)
	}
}

func testSecret() []byte {
	secret := make([]byte, 32)
	for i := range secret {
		secret[i] = byte(i + 3)
	}
	return secret
}

func mustVerifier(t *testing.T, secret []byte) *Verifier {
	t.Helper()
	verifier, err := NewVerifier(secret, "test-issuer", "test-audience", 30*time.Second)
	if err != nil {
		t.Fatal(err)
	}
	return verifier
}

func validClaims(exp time.Time) jwt.Claims {
	return claims("test-issuer", "test-audience", "user-1", exp)
}

func claims(issuer, audience, subject string, exp time.Time) jwt.Claims {
	return jwt.Claims{
		Issuer:   issuer,
		Subject:  subject,
		Audience: jwt.Audience{audience},
		Expiry:   jwt.NewNumericDate(exp),
		IssuedAt: jwt.NewNumericDate(time.Now().Add(-time.Second)),
	}
}

func claimsWithoutExpiry() jwt.Claims {
	value := validClaims(time.Now().Add(time.Minute))
	value.Expiry = nil
	return value
}

func mustSign(t *testing.T, secret []byte, alg jose.SignatureAlgorithm, claims jwt.Claims) string {
	t.Helper()
	key := secret
	if alg == jose.HS384 && len(key) < 48 {
		padded := make([]byte, 48)
		copy(padded, key)
		key = padded
	}
	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: alg, Key: key}, (&jose.SignerOptions{}).WithType("JWT"))
	if err != nil {
		t.Fatal(err)
	}
	raw, err := jwt.Signed(signer).Claims(claims).Serialize()
	if err != nil {
		t.Fatal(err)
	}
	return raw
}

func mustSignAlg(t *testing.T, secret []byte, alg jose.SignatureAlgorithm) string {
	t.Helper()
	return mustSign(t, secret, alg, validClaims(time.Now().Add(time.Minute)))
}
