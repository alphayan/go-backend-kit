package auth

import (
	"context"
	"errors"
	"time"

	"github.com/go-jose/go-jose/v4"
	"github.com/go-jose/go-jose/v4/jwt"
)

type Identity struct {
	Subject string
}

type Verifier struct {
	secret   []byte
	issuer   string
	audience string
	leeway   time.Duration
}

type identityContextKey struct{}

var errUnauthorized = errors.New("unauthorized")

func NewVerifier(secret []byte, issuer, audience string, leeway time.Duration) (*Verifier, error) {
	if len(secret) < 32 {
		return nil, errors.New("jwt secret must be at least 32 bytes")
	}
	if issuer == "" || audience == "" {
		return nil, errors.New("jwt issuer and audience are required")
	}
	if leeway < 0 || leeway > 2*time.Minute {
		return nil, errors.New("jwt leeway must be between 0 and 2m")
	}
	copied := make([]byte, len(secret))
	copy(copied, secret)
	return &Verifier{secret: copied, issuer: issuer, audience: audience, leeway: leeway}, nil
}

func (v *Verifier) Verify(raw string) (Identity, error) {
	token, err := jwt.ParseSigned(raw, []jose.SignatureAlgorithm{jose.HS256})
	if err != nil {
		return Identity{}, errUnauthorized
	}
	var claims jwt.Claims
	if err := token.Claims(v.secret, &claims); err != nil {
		return Identity{}, errUnauthorized
	}
	if claims.Issuer == "" || claims.Subject == "" || len(claims.Audience) == 0 || claims.Expiry == nil {
		return Identity{}, errUnauthorized
	}
	if err := claims.ValidateWithLeeway(jwt.Expected{
		Issuer:      v.issuer,
		Subject:     claims.Subject,
		AnyAudience: jwt.Audience{v.audience},
		Time:        time.Now(),
	}, v.leeway); err != nil {
		return Identity{}, errUnauthorized
	}
	return Identity{Subject: claims.Subject}, nil
}

func WithIdentity(ctx context.Context, identity Identity) context.Context {
	return context.WithValue(ctx, identityContextKey{}, identity)
}

func IdentityFrom(ctx context.Context) (Identity, bool) {
	identity, ok := ctx.Value(identityContextKey{}).(Identity)
	return identity, ok
}
