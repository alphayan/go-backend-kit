import { test, expect, type Page } from "@playwright/test"

async function signIn(page: Page, email: string, password: string) {
  await page.goto("/admin/login")
  await page.getByLabel("Email", { exact: true }).fill(email)
  await page.getByLabel("Password", { exact: true }).fill(password)
  await page.getByRole("button", { name: "Sign in", exact: true }).click()
  await expect(page.getByRole("button", { name: "Sign out", exact: true })).toBeVisible()
}

test("admin users, audit, viewer restrictions, password rotation and expiry", async ({ page, browser }) => {
  await signIn(page, "browser-admin@example.test", "browser test initial password")
  await page.getByRole("link", { name: "Users", exact: true }).click()
  const self = page.getByRole("row").filter({ hasText: "browser-admin@example.test" })
  await expect(self.getByRole("button", { name: "Edit access" })).toBeDisabled()
  await page.getByRole("button", { name: "Create user" }).click()
  const dialog = page.getByRole("dialog")
  await dialog.getByLabel("Email", { exact: true }).fill("browser-viewer@example.test")
  await dialog.getByLabel("Initial password").fill("browser viewer password")
  await dialog.getByRole("button", { name: "Save user" }).click()
  await expect(dialog).not.toBeVisible()
  const viewerRow = page.getByRole("row").filter({ hasText: "browser-viewer@example.test" })
  await expect(viewerRow).toBeVisible()

  const viewerContext = await browser.newContext({ baseURL: new URL(page.url()).origin, viewport: { width: 1280, height: 800 } })
  const viewer = await viewerContext.newPage()
  try {
    await signIn(viewer, "browser-viewer@example.test", "browser viewer password")
    await expect(viewer.getByRole("link", { name: "Users", exact: true })).toHaveCount(0)
    await viewer.goto("/admin/users")
    await expect(viewer).toHaveURL(/\/admin\/$/)
    expect((await viewerContext.request.get("/auth/users")).status()).toBe(403)

    await viewerRow.getByRole("button", { name: "Edit access" }).click()
    await dialog.getByLabel("Account disabled").check()
    await dialog.getByRole("button", { name: "Save user" }).click()
    await expect(dialog).not.toBeVisible()
    await viewer.reload()
    await expect(viewer).toHaveURL(/\/admin\/login/)
    await viewerRow.getByRole("button", { name: "Edit access" }).click()
    await dialog.getByLabel("Account disabled").uncheck()
    await dialog.getByRole("button", { name: "Save user" }).click()
    await expect(dialog).not.toBeVisible()
    await signIn(viewer, "browser-viewer@example.test", "browser viewer password")

    await viewerRow.getByRole("button", { name: "Sessions", exact: true }).click()
    await expect(page.getByRole("heading", { name: "Active sessions: browser-viewer@example.test" })).toBeVisible()
    await page.getByRole("button", { name: "Revoke all sessions" }).click()
    await page.getByRole("dialog").getByRole("button", { name: "Revoke", exact: true }).click()
    await expect(page.getByRole("dialog")).not.toBeVisible()
    await viewer.reload()
    await expect(viewer).toHaveURL(/\/admin\/login/)

    await page.getByRole("link", { name: "Audit logs", exact: true }).click()
    await page.getByLabel("Action", { exact: true }).fill("user_create")
    await page.getByRole("button", { name: "Apply filters" }).click()
    await expect(page.getByRole("cell", { name: "user_create", exact: true })).toBeVisible()
    await expect(page.getByRole("cell", { name: "auth_users", exact: true })).toBeVisible()

    for (const actorID of ["7", "9007199254740993"]) {
      await page.getByLabel("Actor ID", { exact: true }).fill(actorID)
      const response = page.waitForResponse((value) => {
        const url = new URL(value.url())
        return url.pathname === "/auth/audit-logs" && url.searchParams.get("actor_id") === actorID
      })
      await page.getByRole("button", { name: "Apply filters" }).click()
      expect((await response).status()).toBe(200)
    }

    await page.getByRole("link", { name: /browser-admin@example.test/ }).click()
    await page.getByLabel("Current password", { exact: true }).fill("browser test initial password")
    await page.getByLabel("New password", { exact: true }).fill("browser test replacement password")
    await page.getByLabel("Confirm new password").fill("browser test replacement password")
    await page.getByRole("button", { name: "Update password" }).click()
    await expect(page.getByRole("status")).toContainText("Password changed")
    await page.getByRole("button", { name: "Sign out", exact: true }).click()
    await signIn(page, "browser-admin@example.test", "browser test replacement password")
    const restored = await page.request.post("/auth/password", { data: { current_password: "browser test replacement password", new_password: "browser test initial password" } })
    expect(restored.status()).toBe(204)

    await page.setViewportSize({ width: 375, height: 812 })
    await page.emulateMedia({ reducedMotion: "reduce" })
    await page.getByRole("button", { name: "Toggle navigation" }).click()
    await page.getByRole("button", { name: /Theme preference:/ }).click()
    await page.getByRole("link", { name: "Users", exact: true }).click()
    await expect(page.getByRole("heading", { name: "Users", exact: true })).toBeVisible()
    await expect(page.getByRole("button", { name: "Create user" })).toBeInViewport()
  } finally { await viewerContext.close() }
})
