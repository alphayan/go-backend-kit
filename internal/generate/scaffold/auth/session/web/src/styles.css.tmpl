:root {
  font-family: "Avenir Next", Avenir, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #1d2529;
  background: #f4f2ed;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --canvas: #f4f2ed;
  --surface: #fffefa;
  --surface-strong: #ffffff;
  --surface-muted: #ebe8e0;
  --ink: #1d2529;
  --muted: #687176;
  --border: #d9d5cc;
  --accent: #155eef;
  --accent-hover: #0f4dcc;
  --accent-soft: #e8efff;
  --danger: #b42318;
  --danger-soft: #feeceb;
  --success: #17784b;
  --focus: #155eef;
  --shadow: 0 18px 50px rgb(29 37 41 / 8%);
  --radius-sm: 8px;
  --radius: 14px;
  --radius-lg: 22px;
}

:root[data-theme="dark"] {
  color: #edf0f2;
  background: #111619;
  --canvas: #111619;
  --surface: #171d20;
  --surface-strong: #1d2428;
  --surface-muted: #252d31;
  --ink: #edf0f2;
  --muted: #a6afb4;
  --border: #343d42;
  --accent: #7ca5ff;
  --accent-hover: #9abaff;
  --accent-soft: #1d315c;
  --danger: #ff8a82;
  --danger-soft: #4b2424;
  --success: #67d7a1;
  --focus: #9abaff;
  --shadow: 0 18px 50px rgb(0 0 0 / 28%);
}

* { box-sizing: border-box; }
html { min-width: 320px; min-height: 100%; background: var(--canvas); }
body { min-width: 320px; min-height: 100vh; margin: 0; background: var(--canvas); color: var(--ink); }
button, input, select, textarea { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; }
button { color: inherit; }
h1, h2, h3, p { margin-top: 0; }
h1, h2, h3 { font-family: "Avenir Next", Avenir, Inter, ui-sans-serif, sans-serif; letter-spacing: -0.035em; }
h1 { margin-bottom: 12px; font-size: clamp(2rem, 5vw, 3.75rem); line-height: 1.02; }
h2 { margin-bottom: 8px; font-size: clamp(1.35rem, 3vw, 2rem); line-height: 1.15; }
h3 { margin-bottom: 5px; font-size: 1.05rem; }
code { padding: 2px 6px; border-radius: 5px; background: var(--surface-muted); font-size: .88em; }

:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.skip-link { position: fixed; z-index: 1000; top: 10px; left: 10px; padding: 10px 14px; border-radius: var(--radius-sm); background: var(--ink); color: var(--surface); transform: translateY(-150%); }
.skip-link:focus { transform: translateY(0); }
.muted, .page-lead { color: var(--muted); }
.eyebrow { margin-bottom: 9px; color: var(--accent); font: 700 .72rem/1.2 "Avenir Next", sans-serif; letter-spacing: .12em; text-transform: uppercase; }

.app-frame { min-height: 100vh; }
.sidebar { position: fixed; z-index: 40; inset: 0 auto 0 0; display: flex; width: 264px; flex-direction: column; padding: 24px 18px 18px; border-right: 1px solid var(--border); background: var(--surface); }
.brand { display: inline-flex; align-items: center; gap: 11px; color: var(--ink); font: 700 1rem/1 "Avenir Next", sans-serif; text-decoration: none; }
.brand-mark { display: inline-grid; width: 36px; height: 36px; place-items: center; border-radius: 11px; background: var(--ink); color: var(--surface); font-weight: 700; }
.sidebar nav { flex: 1; margin-top: 34px; overflow-y: auto; }
.nav-label { margin: 22px 10px 8px; color: var(--muted); font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.nav-link { display: block; margin: 3px 0; padding: 10px 12px; border-radius: 9px; color: var(--muted); font-size: .9rem; font-weight: 600; text-decoration: none; transition: background 140ms ease, color 140ms ease, transform 140ms ease; }
.nav-link:hover { background: var(--surface-muted); color: var(--ink); transform: translateX(2px); }
.nav-link.router-link-active { background: var(--accent-soft); color: var(--accent); }
.nav-empty { padding: 4px 12px; color: var(--muted); font-size: .8rem; line-height: 1.5; }
.sidebar-footer { padding-top: 14px; border-top: 1px solid var(--border); }
.identity { display: flex; min-width: 0; align-items: center; gap: 10px; padding: 8px; border-radius: 10px; text-decoration: none; }
.identity:hover { background: var(--surface-muted); }
.avatar { display: grid; width: 34px; height: 34px; flex: none; place-items: center; border-radius: 50%; background: var(--accent); color: white; font-weight: 700; }
.identity-copy { display: grid; min-width: 0; }
.identity-copy strong { overflow: hidden; font-size: .82rem; text-overflow: ellipsis; white-space: nowrap; }
.identity-copy small { color: var(--muted); text-transform: capitalize; }
.sidebar-actions { display: flex; justify-content: space-between; margin-top: 8px; }
.text-button, .link-button, .sort-button, .icon-button { border: 0; background: transparent; cursor: pointer; }
.text-button { padding: 7px 8px; color: var(--muted); font-size: .78rem; }
.text-button:hover, .link-button:hover { color: var(--ink); }
.mobile-header { display: none; }
.menu-backdrop { display: none; }
.main-content { min-height: 100vh; margin-left: 264px; padding: clamp(24px, 5vw, 64px); }
.page-stack { display: grid; width: min(100%, 1500px); margin: 0 auto; gap: clamp(30px, 5vw, 56px); }
.narrow-page { width: min(100%, 980px); }
.page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding-bottom: 28px; border-bottom: 1px solid var(--border); }
.page-header h1 { margin-bottom: 8px; }
.page-lead { margin-bottom: 0; font-size: 1rem; }
.hero-header { min-height: 230px; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 18px; }
.section-heading h2 { margin-bottom: 0; }
.count-badge { display: inline-grid; min-width: 36px; height: 28px; place-items: center; border-radius: 999px; background: var(--surface-muted); font-size: .8rem; font-weight: 700; }

.resource-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px; }
.resource-card { display: grid; min-height: 145px; grid-template-columns: auto 1fr auto; align-items: end; gap: 18px; padding: 22px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: 0 2px 0 rgb(29 37 41 / 2%); text-decoration: none; transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease; }
.resource-card:hover { border-color: var(--accent); box-shadow: var(--shadow); transform: translateY(-3px); }
.resource-card p { margin: 0; color: var(--muted); font-size: .83rem; }
.resource-number { align-self: start; color: var(--muted); font: 600 .72rem/1 "Avenir Next", sans-serif; }
.card-arrow { color: var(--accent); font-size: 1.5rem; }
.empty-state { display: grid; min-height: 280px; place-items: center; align-content: center; padding: 36px; border: 1px dashed var(--border); border-radius: var(--radius-lg); color: var(--muted); text-align: center; }
.empty-state h1, .empty-state h3 { color: var(--ink); }
.empty-state p { max-width: 520px; line-height: 1.6; }
.empty-glyph { margin-bottom: 18px; color: var(--accent); font: 600 2rem/1 "Avenir Next", sans-serif; }
.full-state { min-height: calc(100vh - 128px); }

.button { display: inline-flex; min-height: 42px; align-items: center; justify-content: center; gap: 8px; padding: 10px 17px; border: 1px solid transparent; border-radius: 9px; font-weight: 700; text-decoration: none; cursor: pointer; transition: background 140ms ease, border-color 140ms ease, transform 140ms ease; }
.button:hover:not(:disabled) { transform: translateY(-1px); }
.button:disabled { cursor: not-allowed; opacity: .55; }
.button.primary { background: var(--accent); color: white; }
.button.primary:hover:not(:disabled) { background: var(--accent-hover); }
.button.secondary { border-color: var(--border); background: var(--surface); color: var(--ink); }
.button.secondary:hover:not(:disabled) { border-color: var(--muted); }
.button.danger { background: var(--danger); color: white; }
.button.compact { min-height: 34px; padding: 6px 11px; font-size: .8rem; }
.button.full { width: 100%; }
.icon-button { display: inline-grid; width: 40px; height: 40px; place-items: center; border-radius: 9px; font-size: 1.4rem; }
.icon-button:hover { background: var(--surface-muted); }

input, select, textarea { width: 100%; border: 1px solid var(--border); border-radius: 9px; background: var(--surface-strong); color: var(--ink); transition: border-color 140ms ease, box-shadow 140ms ease; }
input, select { min-height: 42px; padding: 9px 11px; }
textarea { padding: 11px; line-height: 1.55; resize: vertical; }
input:hover, select:hover, textarea:hover { border-color: var(--muted); }
input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); outline: 0; }
input[aria-invalid="true"], select[aria-invalid="true"], textarea[aria-invalid="true"] { border-color: var(--danger); }
label { font-size: .84rem; font-weight: 700; }

.toolbar { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; margin-top: -30px; padding: 16px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
.search-box { display: flex; min-width: min(100%, 340px); flex: 1 1 340px; gap: 8px; }
.filter-control { display: grid; min-width: 150px; gap: 5px; }
.filter-control label { color: var(--muted); font-size: .72rem; }
.table-card { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
.table-scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: .86rem; }
th, td { padding: 14px 16px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: middle; white-space: nowrap; }
th { background: var(--surface-muted); color: var(--muted); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover { background: color-mix(in srgb, var(--accent-soft) 36%, transparent); }
.sort-button { display: inline-flex; align-items: center; gap: 6px; padding: 0; color: inherit; font: inherit; letter-spacing: inherit; text-transform: inherit; }
.actions-column { width: 1%; }
.row-actions { display: flex; gap: 12px; justify-content: flex-end; }
.link-button { padding: 4px 0; color: var(--accent); font-size: .8rem; font-weight: 700; }
.danger-text { color: var(--danger); }
.boolean-pill { display: inline-block; padding: 3px 8px; border-radius: 999px; background: var(--surface-muted); font-size: .74rem; }
.table-message { padding: 50px 20px; color: var(--muted); text-align: center; }
.pagination { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 14px 16px; border-top: 1px solid var(--border); background: var(--surface-muted); }
.pagination p { margin: 0; color: var(--muted); font-size: .78rem; }
.pagination div { display: flex; align-items: center; gap: 10px; }
.page-count { min-width: 90px; color: var(--muted); font-size: .75rem; text-align: center; }

.dialog { width: min(92vw, 480px); max-height: 88vh; padding: 0; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
.dialog::backdrop { background: rgb(13 18 21 / 60%); backdrop-filter: blur(5px); }
.dialog-body { padding: 28px; }
.dialog-body h2 { margin-bottom: 12px; }
.dialog-actions, .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }
.form-dialog { width: min(94vw, 720px); }
.resource-form { display: flex; max-height: 88vh; flex-direction: column; }
.form-header { display: flex; align-items: start; justify-content: space-between; padding: 24px 26px 18px; border-bottom: 1px solid var(--border); }
.form-header h2 { margin: 0; }
.form-fields { display: grid; gap: 20px; padding: 24px 26px; overflow-y: auto; }
.form-actions { margin: 0; padding: 16px 26px; border-top: 1px solid var(--border); background: var(--surface-muted); }
.field { display: grid; gap: 7px; }
.field-heading { display: flex; justify-content: space-between; gap: 12px; }
.required, .optional { color: var(--muted); font-size: .68rem; font-weight: 600; text-transform: uppercase; }
.required { color: var(--accent); }
.field-help, .field-error { margin: 0; font-size: .74rem; line-height: 1.45; }
.field-help { color: var(--muted); }
.field-error, .form-error { color: var(--danger); }
.form-error { padding: 11px 13px; border: 1px solid color-mix(in srgb, var(--danger) 32%, transparent); border-radius: 8px; background: var(--danger-soft); font-size: .82rem; line-height: 1.45; }
.success-message, .notice { padding: 11px 13px; border-radius: 8px; background: color-mix(in srgb, var(--success) 12%, transparent); color: var(--success); font-size: .82rem; }
.null-toggle, .switch-row { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .78rem; font-weight: 500; }
.null-toggle input, .switch-row input { width: 17px; min-height: 17px; margin: 0; }

.settings-card { display: grid; grid-template-columns: minmax(220px, .8fr) minmax(280px, 1.2fr); gap: 44px; padding: clamp(24px, 5vw, 44px); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
.settings-intro p { color: var(--muted); line-height: 1.65; }
.settings-form { display: grid; gap: 9px; }
.settings-form label:not(:first-child) { margin-top: 9px; }
.settings-form .button { justify-self: start; margin-top: 10px; }

.login-page { display: grid; min-height: 100vh; grid-template-columns: minmax(360px, 1.1fr) minmax(400px, .9fr); }
.login-story { display: flex; flex-direction: column; justify-content: space-between; padding: clamp(34px, 7vw, 88px); background: #112d2b; color: #f4f5ef; background-image: radial-gradient(circle at 18% 24%, rgb(77 164 149 / 28%), transparent 35%), linear-gradient(145deg, transparent 60%, rgb(255 255 255 / 5%)); }
.login-story .login-brand { display: flex; align-items: center; gap: 12px; font: 700 1rem/1 "Avenir Next", sans-serif; }
.login-story .brand-mark { background: #f4f5ef; color: #112d2b; }
.login-story h1 { max-width: 720px; color: white; font-size: clamp(2.6rem, 6vw, 5.5rem); }
.login-story p:not(.eyebrow) { max-width: 600px; color: #bfcfca; font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.7; }
.login-story .eyebrow { color: #8cd6c2; }
.login-story .login-footnote { margin: 0; font-size: .75rem; }
.login-panel { display: grid; place-items: center; padding: 32px; background: var(--canvas); }
.login-form { display: grid; width: min(100%, 420px); gap: 10px; padding: clamp(26px, 6vw, 48px); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow); }
.login-form > div { margin-bottom: 18px; }
.login-form label:not(:first-of-type) { margin-top: 8px; }

@media (max-width: 900px) {
  .mobile-header { position: sticky; z-index: 50; top: 0; display: flex; height: 66px; align-items: center; justify-content: space-between; padding: 12px 18px; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(14px); }
  .menu-backdrop { position: fixed; z-index: 35; inset: 66px 0 0; display: block; border: 0; background: rgb(13 18 21 / 48%); }
  .sidebar { top: 66px; width: min(86vw, 310px); visibility: hidden; transform: translateX(-105%); transition: transform 180ms ease, visibility 0s linear 180ms; }
  .sidebar.open { visibility: visible; transform: translateX(0); box-shadow: var(--shadow); transition-delay: 0s; }
  .desktop-brand { display: none; }
  .sidebar nav { margin-top: 0; }
  .main-content { margin-left: 0; padding: 30px 18px 48px; }
  .login-page { grid-template-columns: 1fr; }
  .login-story { min-height: 340px; }
  .login-story h1 { font-size: clamp(2.25rem, 11vw, 4rem); }
  .login-panel { padding: 24px 18px 40px; }
}

@media (max-width: 680px) {
  .page-header { align-items: stretch; flex-direction: column; }
  .hero-header { min-height: auto; }
  .toolbar { margin-top: -18px; }
  .search-box { min-width: 100%; }
  .filter-control { flex: 1 1 140px; }
  .settings-card { grid-template-columns: 1fr; gap: 20px; }
  .pagination { align-items: stretch; flex-direction: column; }
  .pagination div { justify-content: space-between; }
  table, thead, tbody, tr, th, td { display: block; }
  thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
  tbody tr { padding: 10px 14px; border-bottom: 1px solid var(--border); }
  tbody tr:last-child { border-bottom: 0; }
  td { display: grid; grid-template-columns: minmax(90px, .45fr) minmax(0, 1fr); gap: 14px; padding: 8px 0; border: 0; white-space: normal; overflow-wrap: anywhere; }
  td::before { content: attr(data-label); color: var(--muted); font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  td[colspan] { display: block; }
  td[colspan]::before { content: none; }
  .row-actions { justify-content: flex-start; }
  .form-header, .form-fields, .form-actions { padding-left: 18px; padding-right: 18px; }
  .login-story { padding: 34px 24px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
}
