<script setup lang="ts">
import { ref } from "vue"
import { useRoute, useRouter } from "vue-router"
import { login } from "@/lib/auth"
import { messageFor } from "@/lib/api"

const route = useRoute()
const router = useRouter()
const email = ref("")
const password = ref("")
const busy = ref(false)
const error = ref("")

async function submit() {
  busy.value = true
  error.value = ""
  try {
    await login(email.value, password.value)
    const redirect = typeof route.query.redirect === "string" && route.query.redirect.startsWith("/") && !route.query.redirect.startsWith("//") ? route.query.redirect : "/"
    await router.replace(redirect)
  } catch (reason) {
    error.value = messageFor(reason)
  } finally {
    busy.value = false
  }
}
</script>

<template>
  <main class="login-page">
    <section class="login-story" aria-labelledby="login-title">
      <div class="login-brand"><span class="brand-mark" aria-hidden="true">G</span><span>Operations Console</span></div>
      <div>
        <p class="eyebrow">First-party administration</p>
        <h1 id="login-title">A calm place to run your backend.</h1>
        <p>Review records, make deliberate changes, and keep every protected operation tied to a revocable session.</p>
      </div>
      <p class="login-footnote">Generated by gobackend · Same-origin session security</p>
    </section>
    <section class="login-panel" aria-label="Sign in">
      <form class="login-form" @submit.prevent="submit">
        <div>
          <p class="eyebrow">Welcome back</p>
          <h2>Sign in to continue</h2>
          <p class="muted">Use the account credentials provided by your administrator.</p>
        </div>
        <p v-if="route.query.expired === '1'" class="notice">Your session expired. Sign in again.</p>
        <label for="email">Email</label>
        <input id="email" v-model.trim="email" type="email" autocomplete="username" required autofocus />
        <label for="password">Password</label>
        <input id="password" v-model="password" type="password" autocomplete="current-password" required />
        <p v-if="error" class="form-error" role="alert" v-text="error" />
        <button class="button primary full" type="submit" :disabled="busy" v-text="busy ? 'Signing in…' : 'Sign in'" />
      </form>
    </section>
  </main>
</template>
