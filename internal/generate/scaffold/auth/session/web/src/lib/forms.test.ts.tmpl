import { describe, expect, it, vi } from "vitest"
import { buildPayload, initialValues, int64Schema, jsonSchema } from "./forms"
import { parseJSON, stringifyJSON } from "./api"
import type { FieldDefinition, ResourceRecord } from "./resource"

const fields: FieldDefinition[] = [
  { name: "name", label: "Name", type: "string", required: true, nullable: false, hasDefault: false, enumValues: [], filterable: false, sortable: false, searchable: true },
  { name: "count", label: "Count", type: "int32", required: false, nullable: false, hasDefault: false, enumValues: [], filterable: true, sortable: true, searchable: false },
  { name: "metadata", label: "Metadata", type: "json", required: false, nullable: true, hasDefault: false, enumValues: [], filterable: false, sortable: false, searchable: false },
]

describe("form serialization", () => {
  it("preserves signed int64 limits, explicit zero, defaults and nested JSON", () => {
    const integers: FieldDefinition[] = [
      { ...fields[1]!, name: "owner_id", type: "int64", hasDefault: true, defaultValue: "9007199254740993" },
      { ...fields[2]!, hasDefault: true, defaultValue: '{"id":9007199254740993}' },
    ]
    const values = initialValues(integers)
    expect(values.owner_id).toBe("9007199254740993")
    expect(values.metadata).toBe('{"id":9007199254740993}')
    values.metadata = '{"id":9007199254740993}'
    const payload = buildPayload(integers, values, new Set(), new Set(["owner_id", "metadata"]), "create")
    expect(int64Schema().parse(payload.owner_id)).toBe(9007199254740993n)
    expect(jsonSchema.parse(payload.metadata)).toEqual({ id: 9007199254740993n })
    expect(stringifyJSON(payload)).toBe('{"owner_id":9007199254740993,"metadata":{"id":9007199254740993}}')
    for (const value of [-9223372036854775808n, 0n, 9223372036854775807n]) expect(int64Schema().safeParse(value).success).toBe(true)
    for (const value of [-9223372036854775809n, 9223372036854775808n, 1.5, "bad"]) expect(int64Schema().safeParse(value).success).toBe(false)
    expect(int64Schema("9007199254740993", "9007199254740995").safeParse(9007199254740992n).success).toBe(false)
    expect(int64Schema("9007199254740993", "9007199254740995").safeParse(9007199254740994n).success).toBe(true)
    values.owner_id = "0"
    expect(buildPayload(integers, values, new Set(), new Set(["owner_id"]), "update")).toEqual({ owner_id: 0n })
    const record = { id: 9223372036854775807n, created_at: "", updated_at: "", owner_id: -9223372036854775808n, metadata: parseJSON('{"id":9007199254740993}') }
    expect(initialValues(integers, record)).toEqual({ owner_id: "-9223372036854775808", metadata: '{\n  "id": 9007199254740993\n}' })
    for (const value of [undefined, () => {}, NaN]) expect(jsonSchema.safeParse({ value }).success).toBe(false)
  })

  it("displays encoded JSON defaults without requiring native precision support", () => {
    const nativeJSON = JSON
    vi.stubGlobal("JSON", {
      parse: (text: string, reviver: (key: string, value: unknown) => unknown) => nativeJSON.parse(text, (key, value: unknown) => reviver(key, value)),
      stringify: nativeJSON.stringify,
    })
    try {
      const definition: FieldDefinition[] = [{ ...fields[2]!, hasDefault: true, defaultValue: '{"id":9007199254740993}' }]
      expect(initialValues(definition).metadata).toBe('{"id":9007199254740993}')
      expect(initialValues(definition, { id: 1, created_at: "", updated_at: "", metadata: { id: 7 } }).metadata).toBe('{\n  "id": 7\n}')
    } finally { vi.unstubAllGlobals() }
  })

  it("sends required create fields and only touched optional fields", () => {
    const values = initialValues(fields)
    values.name = "Example"
    values.count = "7"
    expect(buildPayload(fields, values, new Set(), new Set(["count"]), "create")).toEqual({ name: "Example", count: 7 })
  })

  it("creates a minimal patch and preserves explicit null", () => {
    const record = { id: 1, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z", name: "Old", count: 2, metadata: {} } satisfies ResourceRecord
    const values = initialValues(fields, record)
    values.name = "New"
    expect(buildPayload(fields, values, new Set(["metadata"]), new Set(["name", "metadata"]), "update")).toEqual({ name: "New", metadata: null })
  })

  it("does not resend an untouched existing null in a patch", () => {
    const record = { id: 1, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z", name: "Old", count: 2, metadata: null } satisfies ResourceRecord
    const values = initialValues(fields, record)
    values.name = "New"
    expect(buildPayload(fields, values, new Set(["metadata"]), new Set(["name"]), "update")).toEqual({ name: "New" })
  })

  it("parses JSON and numeric inputs without changing decimal strings", () => {
    const extended: FieldDefinition[] = [
      ...fields,
      { name: "price", label: "Price", type: "decimal", required: true, nullable: false, hasDefault: false, enumValues: [], filterable: false, sortable: false, searchable: false },
    ]
    const values = initialValues(extended)
    values.name = "Example"
    values.count = "8"
    values.metadata = "{\"ok\":true}"
    values.price = "9007199254740993.01"
    expect(buildPayload(extended, values, new Set(), new Set(["count", "metadata"]), "create")).toEqual({
      name: "Example",
      count: 8,
      metadata: { ok: true },
      price: "9007199254740993.01",
    })
  })
})
