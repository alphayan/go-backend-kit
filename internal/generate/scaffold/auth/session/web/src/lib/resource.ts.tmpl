import type { z } from "zod"
import { stringifyJSON } from "./api"

export type FieldKind = "string" | "text" | "bool" | "int32" | "int64" | "float64" | "decimal" | "time" | "uuid" | "json"

export interface FieldDefinition {
  name: string
  label: string
  type: FieldKind
  required: boolean
  nullable: boolean
  hasDefault: boolean
  defaultValue?: unknown
  enumValues: string[]
  filterable: boolean
  sortable: boolean
  searchable: boolean
  min?: string
  max?: string
  maxLength?: number
}

export interface ColumnDefinition {
  key: string
  label: string
  kind: FieldKind | "id" | "timestamp"
  sortable: boolean
}

export interface ResourceDefinition {
  key: string
  name: string
  route: string
  apiPath: string
  fields: FieldDefinition[]
  columns: ColumnDefinition[]
  createSchema: z.ZodType<Record<string, unknown>>
  updateSchema: z.ZodType<Record<string, unknown>>
}

export type ResourceRecord = Record<string, unknown> & {
  id: number | bigint
  created_at: string
  updated_at: string
}

export function humanize(value: string): string {
  return value.replaceAll("_", " ").replace(/\b\w/g, (letter) => letter.toUpperCase())
}

export function formatCell(value: unknown, kind: ColumnDefinition["kind"]): string {
  if (value === null || value === undefined) return "—"
  if (kind === "bool") return value ? "Yes" : "No"
  if (kind === "timestamp" || kind === "time") {
    const date = new Date(String(value))
    return Number.isNaN(date.valueOf()) ? String(value) : new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(date)
  }
  if (kind === "json") return stringifyJSON(value)
  return String(value)
}
