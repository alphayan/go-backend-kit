import { afterEach, describe, expect, it, vi } from "vitest"
import { APIError, apiRequest, messageFor, parseJSON, stringifyJSON } from "./api"

afterEach(() => vi.unstubAllGlobals())

describe("apiRequest", () => {
  it("preserves unsafe integers in responses, nested JSON and request bodies", async () => {
    const body = '{"data":{"id":9223372036854775807,"owner_id":9007199254740993,"metadata":{"negative":-9223372036854775808},"small":7,"ratio":1.25,"text":"9007199254740993"}}'
    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(new Response(body, { status: 200 })))
    const record = await apiRequest<Record<string, unknown>>("/api/v1/things")
    expect(record).toEqual({ id: 9223372036854775807n, owner_id: 9007199254740993n, metadata: { negative: -9223372036854775808n }, small: 7, ratio: 1.25, text: "9007199254740993" })
    expect(stringifyJSON({ data: record })).toBe(body)
    expect(parseJSON('[9007199254740993,"9007199254740993",1e20]')).toEqual([9007199254740993n, "9007199254740993", 1e20])
  })

  it("fails explicitly on large integers when native JSON precision support is missing", () => {
    const nativeJSON = JSON
    vi.stubGlobal("JSON", {
      parse: (text: string, reviver: (key: string, value: unknown) => unknown) => nativeJSON.parse(text, (key, value: unknown) => reviver(key, value)),
      stringify: nativeJSON.stringify,
    })
    expect(parseJSON('{"id":7,"ratio":1.25}')).toEqual({ id: 7, ratio: 1.25 })
    expect(stringifyJSON({ id: 7 })).toBe('{"id":7}')
    expect(stringifyJSON({ id: 7n, zero: 0n })).toBe('{"id":7,"zero":0}')
    expect(() => parseJSON('{"id":9007199254740993}')).toThrow("Update your browser")
    expect(() => stringifyJSON({ id: 9007199254740993n })).toThrow("Update your browser")
  })

  it("unwraps data and sends same-origin credentials", async () => {
    const fetchMock = vi.fn().mockResolvedValue(new Response(JSON.stringify({ data: { id: 7 } }), { status: 200 }))
    vi.stubGlobal("fetch", fetchMock)

    await expect(apiRequest<{ id: number }>("/api/v1/things")).resolves.toEqual({ id: 7 })
    expect(fetchMock).toHaveBeenCalledWith("/api/v1/things", expect.objectContaining({ credentials: "same-origin" }))
  })

  it("preserves field details and request id", async () => {
    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(new Response(JSON.stringify({
      error: { code: "validation_failed", message: "invalid", details: { name: "required" }, request_id: "req-1" },
    }), { status: 422 })))

    const error = await apiRequest("/api/v1/things").catch((reason: unknown) => reason)
    expect(error).toBeInstanceOf(APIError)
    expect((error as APIError).details).toEqual({ name: "required" })
    expect(messageFor(error)).toContain("req-1")
  })

  it("accepts an empty 204 response", async () => {
    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(new Response(null, { status: 204 })))
    await expect(apiRequest<void>("/auth/logout", { method: "POST" })).resolves.toBeUndefined()
  })

  it("rejects malformed success JSON instead of returning an unchecked value", async () => {
    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(new Response("not-json", { status: 200 })))
    const error = await apiRequest("/api/v1/things").catch((reason: unknown) => reason)
    expect(error).toBeInstanceOf(APIError)
    expect((error as APIError).code).toBe("invalid_response")
  })
})
