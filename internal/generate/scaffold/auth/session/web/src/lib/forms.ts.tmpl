import { z } from "zod"
import type { FieldDefinition, ResourceRecord } from "./resource"

export type FormValue = string | boolean
export type FormValues = Record<string, FormValue>

export function numberSchema(integer: boolean, min?: string, max?: string) {
  let schema = z.number()
  if (integer) schema = schema.int()
  if (min !== undefined) schema = schema.min(Number(min))
  if (max !== undefined) schema = schema.max(Number(max))
  return schema
}

export function decimalSchema(min?: string, max?: string) {
  return z.string().regex(/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/, "Enter a valid decimal").superRefine((value, context) => {
    const number = Number(value)
    if (min !== undefined && number < Number(min)) context.addIssue({ code: "custom", message: `Must be at least ${min}` })
    if (max !== undefined && number > Number(max)) context.addIssue({ code: "custom", message: `Must be at most ${max}` })
  })
}

export const dateTimeSchema = z.string().datetime({ offset: true })
export const jsonSchema = z.json()

export function initialValues(fields: FieldDefinition[], record?: ResourceRecord): FormValues {
  return Object.fromEntries(fields.map((field) => {
    const source = record?.[field.name] ?? field.defaultValue
    if (field.type === "bool") return [field.name, Boolean(source)]
    if (field.type === "json" && source !== undefined && source !== null) return [field.name, JSON.stringify(source, null, 2)]
    if (field.type === "time" && source !== undefined && source !== null) return [field.name, toLocalDateTime(String(source))]
    return [field.name, source === undefined || source === null ? "" : String(source)]
  }))
}

export function buildPayload(fields: FieldDefinition[], values: FormValues, nullFields: Set<string>, touched: Set<string>, mode: "create" | "update"): Record<string, unknown> {
  const payload: Record<string, unknown> = {}
  for (const field of fields) {
    if (mode === "update" && !touched.has(field.name)) continue
    if (nullFields.has(field.name)) {
      payload[field.name] = null
      continue
    }
    if (mode === "create" && !field.required && !touched.has(field.name)) continue
    const value = values[field.name]
    if (value === undefined) continue
    if (field.type === "bool") {
      payload[field.name] = Boolean(value)
      continue
    }
    const raw = String(value)
    if (raw === "" && field.type !== "string" && field.type !== "text" && field.type !== "decimal") continue
    switch (field.type) {
    case "int32":
    case "int64":
    case "float64":
      payload[field.name] = Number(raw)
      break
    case "json":
      payload[field.name] = JSON.parse(raw) as unknown
      break
    case "time":
      payload[field.name] = new Date(raw).toISOString()
      break
    default:
      payload[field.name] = raw
    }
  }
  return payload
}

export function zodDetails(error: z.ZodError): Record<string, string> {
  const details: Record<string, string> = {}
  for (const issue of error.issues) {
    const field = String(issue.path[0] ?? "form")
    details[field] ??= issue.message
  }
  return details
}

function toLocalDateTime(value: string): string {
  const date = new Date(value)
  if (Number.isNaN(date.valueOf())) return value
  const offset = date.getTimezoneOffset() * 60_000
  return new Date(date.valueOf() - offset).toISOString().slice(0, 16)
}
