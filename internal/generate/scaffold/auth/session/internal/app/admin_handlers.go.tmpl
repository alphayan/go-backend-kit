func (h *authHandler) adminMiddleware() echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c *echo.Context) error {
			identity, ok := auth.IdentityFromContext(c.Request().Context())
			if !ok { return httpx.WriteError(c, apperror.Unauthorized()) }
			if identity.Role != "admin" {
				h.audit(c, new(identity.UserID), "admin_authorize", "denied")
				return httpx.WriteError(c, apperror.Forbidden())
			}
			c.Response().Header().Set("Cache-Control", "no-store")
			return next(c)
		}
	}
}

func (h *authHandler) listUsers(c *echo.Context) error {
	page, size, err := httpx.ParsePage(c.QueryParam("page"), c.QueryParam("page_size"))
	if err != nil { return httpx.WriteError(c, err) }
	email := strings.ToLower(strings.TrimSpace(c.QueryParam("email")))
	if email != "" && !validEmail(email) { return httpx.WriteError(c, apperror.BadRequest("invalid_email", "email must be a valid address")) }
	users, total, err := h.store.ListUsers(c.Request().Context(), email, page, size)
	if err != nil { return adminError(c, err) }
	return httpx.WriteData(c, http.StatusOK, httpx.NewPage(users, page, size, total))
}

func (h *authHandler) createUser(c *echo.Context) error {
	var input struct {
		Email string `json:"email"`
		Password string `json:"password"`
		Role string `json:"role"`
	}
	if err := httpx.DecodeJSON(c.Request().Body, &input); err != nil { return httpx.WriteError(c, apperror.BadRequest("invalid_json", "request body must be valid JSON")) }
	input.Email = strings.ToLower(strings.TrimSpace(input.Email))
	if !validEmail(input.Email) || len(input.Password) < 12 || len(input.Password) > 1024 || (input.Role != "admin" && input.Role != "viewer") {
		return httpx.WriteError(c, apperror.BadRequest("invalid_user", "provide a valid email, a password of 12 to 1024 bytes, and an admin or viewer role"))
	}
	identity, _ := auth.IdentityFromContext(c.Request().Context())
	permit, ok := h.passwords.TryAcquire()
	if !ok { return httpx.WriteError(c, apperror.TooManyRequests()) }
	defer permit.Release()
	hash, err := permit.Hash(input.Password)
	if err != nil { return adminError(c, err) }
	user, err := h.store.AdminCreateUser(c.Request().Context(), identity.UserID, input.Email, hash, input.Role)
	if err != nil { return adminError(c, err) }
	h.auditUser(c, user.ID, "user_create")
	return httpx.WriteData(c, http.StatusCreated, user)
}

func (h *authHandler) updateUser(c *echo.Context) error {
	id, err := positiveID(c.Param("id"))
	if err != nil { return httpx.WriteError(c, err) }
	var input struct {
		Role optional.Field[string] `json:"role"`
		Disabled optional.Field[bool] `json:"disabled"`
	}
	if err := httpx.DecodeJSON(c.Request().Body, &input); err != nil { return httpx.WriteError(c, apperror.BadRequest("invalid_json", "request body must be valid JSON")) }
	if input.Role.IsNull() || input.Disabled.IsNull() { return httpx.WriteError(c, apperror.BadRequest("invalid_user_update", "role and disabled cannot be null")) }
	if !input.Role.IsSet() && !input.Disabled.IsSet() { return httpx.WriteError(c, apperror.BadRequest("empty_update", "provide role or disabled")) }
	var role *string
	var disabled *bool
	if value, ok := input.Role.Value(); ok { role = new(value) }
	if value, ok := input.Disabled.Value(); ok { disabled = new(value) }
	identity, _ := auth.IdentityFromContext(c.Request().Context())
	user, err := h.store.AdminUpdateUser(c.Request().Context(), identity.UserID, id, role, disabled, time.Now().UTC())
	if err != nil { return adminError(c, err) }
	h.auditUser(c, id, "user_update")
	return httpx.WriteData(c, http.StatusOK, user)
}

func (h *authHandler) listSessions(c *echo.Context) error {
	id, err := positiveID(c.Param("id"))
	if err != nil { return httpx.WriteError(c, err) }
	page, size, err := httpx.ParsePage(c.QueryParam("page"), c.QueryParam("page_size"))
	if err != nil { return httpx.WriteError(c, err) }
	rows, total, err := h.store.ListUserSessions(c.Request().Context(), id, time.Now().UTC(), h.cfg.AuthSessionIdleTimeout, page, size)
	if err != nil { return adminError(c, err) }
	return httpx.WriteData(c, http.StatusOK, httpx.NewPage(rows, page, size, total))
}

func (h *authHandler) revokeSessions(c *echo.Context) error {
	id, err := positiveID(c.Param("id"))
	if err != nil { return httpx.WriteError(c, err) }
	var sessionID int64
	if raw := c.Param("session_id"); raw != "" {
		sessionID, err = positiveID(raw)
		if err != nil { return httpx.WriteError(c, err) }
	}
	identity, _ := auth.IdentityFromContext(c.Request().Context())
	if err := h.store.AdminRevokeSessions(c.Request().Context(), identity.UserID, id, sessionID); err != nil { return adminError(c, err) }
	h.auditUser(c, id, "sessions_revoke")
	return c.NoContent(http.StatusNoContent)
}

func (h *authHandler) listAudits(c *echo.Context) error {
	page, size, err := httpx.ParsePage(c.QueryParam("page"), c.QueryParam("page_size"))
	if err != nil { return httpx.WriteError(c, err) }
	filter := audit.Filter{Action: c.QueryParam("action"), Resource: c.QueryParam("resource"), Outcome: c.QueryParam("outcome")}
	if len(filter.Action) > 64 || len(filter.Resource) > 128 || len(filter.Outcome) > 32 { return httpx.WriteError(c, apperror.BadRequest("invalid_filter", "filter is too long")) }
	if raw := c.QueryParam("actor_id"); raw != "" {
		id, err := positiveID(raw)
		if err != nil { return httpx.WriteError(c, err) }
		filter.ActorID = new(id)
	}
	for key, target := range map[string]*time.Time{"from": &filter.From, "to": &filter.To} {
		if raw := c.QueryParam(key); raw != "" {
			value, err := time.Parse(time.RFC3339, raw)
			if err != nil { return httpx.WriteError(c, apperror.BadRequest("invalid_time", "from and to must be RFC3339 timestamps")) }
			*target = value.UTC()
		}
	}
	if !filter.From.IsZero() && !filter.To.IsZero() && !filter.From.Before(filter.To) { return httpx.WriteError(c, apperror.BadRequest("invalid_time_range", "from must precede to (exclusive)")) }
	rows, total, err := h.audits.List(c.Request().Context(), filter, page, size)
	if err != nil { return adminError(c, err) }
	return httpx.WriteData(c, http.StatusOK, httpx.NewPage(rows, page, size, total))
}

func positiveID(raw string) (int64, error) {
	id, err := strconv.ParseInt(raw, 10, 64)
	if err != nil || id <= 0 { return 0, apperror.BadRequest("invalid_id", "id must be a positive integer") }
	return id, nil
}

func adminError(c *echo.Context, err error) error {
	switch {
	case errors.Is(err, auth.ErrAdminRequired):
		return httpx.WriteError(c, apperror.Forbidden())
	case errors.Is(err, auth.ErrSelfUpdate), errors.Is(err, auth.ErrInvalidRole):
		return httpx.WriteError(c, apperror.BadRequest("invalid_user_update", err.Error()))
	case errors.Is(err, auth.ErrUserNotFound), errors.Is(err, auth.ErrSessionNotFound):
		return httpx.WriteError(c, &apperror.Error{Status: 404, Code: "not_found", Message: "user or session not found"})
	case errors.Is(err, auth.ErrEmailConflict):
		return httpx.WriteError(c, &apperror.Error{Status: 409, Code: "email_conflict", Message: "email already exists"})
	default:
		return httpx.WriteError(c, apperror.FromDatabase(err))
	}
}

func (h *authHandler) auditUser(c *echo.Context, userID int64, action string) {
	identity, _ := auth.IdentityFromContext(c.Request().Context())
	h.audits.BestEffort(context.WithoutCancel(c.Request().Context()), audit.Event{
		ActorID: new(identity.UserID), Action: action, Resource: "auth_users", ResourceID: strconv.FormatInt(userID, 10),
		Outcome: "success", RequestID: requestID(c), CreatedAt: time.Now().UTC(),
	})
}
