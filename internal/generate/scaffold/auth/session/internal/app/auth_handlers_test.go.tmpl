	e.HTTPErrorHandler = func(c *echo.Context, err error) { _ = err }
	e.Use(sessionMiddleware(auth.NewStore(db), sessionTestConfig()))
	e.GET("/protected", func(c *echo.Context) error { return c.NoContent(http.StatusNoContent) })

	response := sessionRequest(e, http.MethodGet, "/protected", nil, &http.Cookie{Name: "session", Value: "opaque-token"}, nil)
	if response.Code != http.StatusInternalServerError {
		t.Fatalf("database failure status = %d, body = %s", response.Code, response.Body.String())
	}
}

func sessionTestDB(t *testing.T) *gorm.DB {
	t.Helper()
	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: gormlogger.Default.LogMode(gormlogger.Silent)})
	if err != nil { t.Fatal(err) }
	sqlDB, err := db.DB()
	if err != nil { t.Fatal(err) }
	sqlDB.SetMaxOpenConns(1)
	if err := db.AutoMigrate(&auth.User{}, &auth.Session{}, &auth.AuditLog{}); err != nil { t.Fatal(err) }
	return db
}

func sessionTestPasswords(t *testing.T) *auth.PasswordManager {
	t.Helper()
	manager, err := auth.NewPasswordManager(auth.DefaultPasswordParams(), 4)
	if err != nil { t.Fatal(err) }
	return manager
}

func createSessionTestUser(t *testing.T, store *auth.Store, passwords *auth.PasswordManager, email, role, password string) auth.User {
	t.Helper()
	permit, ok := passwords.TryAcquire()
	if !ok { t.Fatal("password permit unavailable") }
	hash, err := permit.Hash(password)
	permit.Release()
	if err != nil { t.Fatal(err) }
	user, err := store.CreateUser(t.Context(), email, hash, role)
	if err != nil { t.Fatal(err) }
	return user
}

func sessionTestConfig() config.Config {
	return config.Config{
		RequestTimeout: 15 * time.Second, AuthSessionTTL: time.Hour, AuthSessionIdleTimeout: 30 * time.Minute,
		AuthLoginRateLimit: 20, AuthLoginRateWindow: time.Minute,
	}
}

func sessionRequest(handler http.Handler, method, path string, payload any, cookie *http.Cookie, headers map[string]string) *httptest.ResponseRecorder {
	var body *bytes.Reader
	if payload == nil {
		body = bytes.NewReader(nil)
	} else {
		data, _ := json.Marshal(payload)
		body = bytes.NewReader(data)
	}
	request := httptest.NewRequest(method, path, body)
	request.Header.Set("Content-Type", "application/json")
	request.Header.Set("X-Request-ID", "session-test-request")
	if cookie != nil { request.AddCookie(cookie) }
	for key, value := range headers { request.Header.Set(key, value) }
	response := httptest.NewRecorder()
	handler.ServeHTTP(response, request)
	return response
}
