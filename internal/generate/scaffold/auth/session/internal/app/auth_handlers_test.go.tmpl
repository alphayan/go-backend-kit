func TestSessionPermissionCrossOriginAndAudit(t *testing.T) {
	db := sessionTestDB(t)
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	passwords := sessionTestPasswords(t)
	store := auth.NewStore(db)
	admin := createSessionTestUser(t, store, passwords, "admin@example.com", "admin", "correct horse battery staple")
	viewer := createSessionTestUser(t, store, passwords, "viewer@example.com", "viewer", "correct horse battery staple")
	now := time.Now().UTC()
	adminToken, err := store.CreateSession(t.Context(), admin, "", "", "test", "127.0.0.1", time.Hour, now)
	if err != nil { t.Fatal(err) }
	viewerToken, err := store.CreateSession(t.Context(), viewer, "", "", "test", "127.0.0.2", time.Hour, now)
	if err != nil { t.Fatal(err) }

	generated.RoutePermissions["GET /api/v1/sample"] = "sample.read"
	generated.RoutePermissions["POST /api/v1/sample"] = "sample.create"
	generated.RoutePermissions["PATCH /api/v1/sample/:id"] = "sample.update"
	generated.RoutePermissions["DELETE /api/v1/sample/:id"] = "sample.delete"
	generated.RolePermissions["admin"]["sample.read"] = struct{}{}
	generated.RolePermissions["admin"]["sample.create"] = struct{}{}
	generated.RolePermissions["admin"]["sample.update"] = struct{}{}
	generated.RolePermissions["admin"]["sample.delete"] = struct{}{}
	generated.RolePermissions["viewer"]["sample.read"] = struct{}{}
	t.Cleanup(func() {
		delete(generated.RoutePermissions, "GET /api/v1/sample")
		delete(generated.RoutePermissions, "POST /api/v1/sample")
		delete(generated.RoutePermissions, "PATCH /api/v1/sample/:id")
		delete(generated.RoutePermissions, "DELETE /api/v1/sample/:id")
		delete(generated.RolePermissions["admin"], "sample.read")
		delete(generated.RolePermissions["admin"], "sample.create")
		delete(generated.RolePermissions["admin"], "sample.update")
		delete(generated.RolePermissions["admin"], "sample.delete")
		delete(generated.RolePermissions["viewer"], "sample.read")
	})

	e := echo.NewWithConfig(echo.Config{Logger: logger})
	e.HTTPErrorHandler = func(c *echo.Context, err error) { _ = err }
	e.Use(middleware.RequestID())
	e.Use(crossOriginMiddleware())
	audits := audit.NewStore(db, logger)
	api := e.Group("/api/v1")
	api.Use(sessionMiddleware(store, sessionTestConfig()), permissionMiddleware(audits), resourceAuditMiddleware(audits, logger))
	api.GET("/sample", func(c *echo.Context) error { return c.NoContent(http.StatusNoContent) })
	api.POST("/sample", func(c *echo.Context) error { return c.NoContent(http.StatusNoContent) })
	api.PATCH("/sample/:id", func(c *echo.Context) error { return c.NoContent(http.StatusNoContent) })
	api.DELETE("/sample/:id", func(c *echo.Context) error { return c.NoContent(http.StatusNoContent) })

	adminCookie := &http.Cookie{Name: "session", Value: adminToken}
	viewerCookie := &http.Cookie{Name: "session", Value: viewerToken}
	var before int64
	if err := db.Model(&auth.AuditLog{}).Count(&before).Error; err != nil { t.Fatal(err) }
	if response := sessionRequest(e, http.MethodGet, "/api/v1/sample", nil, viewerCookie, map[string]string{"Sec-Fetch-Site": "cross-site"}); response.Code != http.StatusNoContent {
		t.Fatalf("viewer read status = %d, body = %s", response.Code, response.Body.String())
	}
	var afterGET int64
	if err := db.Model(&auth.AuditLog{}).Count(&afterGET).Error; err != nil { t.Fatal(err) }
	if afterGET != before {
		t.Fatalf("safe GET wrote %d audit rows", afterGET-before)
	}
	if response := sessionRequest(e, http.MethodPost, "/api/v1/sample", nil, viewerCookie, nil); response.Code != http.StatusForbidden {
		t.Fatalf("viewer write status = %d, body = %s", response.Code, response.Body.String())
	}
	if response := sessionRequest(e, http.MethodPost, "/api/v1/sample", nil, adminCookie, nil); response.Code != http.StatusNoContent {
		t.Fatalf("admin write status = %d, body = %s", response.Code, response.Body.String())
	}
	if response := sessionRequest(e, http.MethodGet, "/api/v1/missing", nil, adminCookie, nil); response.Code != http.StatusForbidden {
		t.Fatalf("missing protected path status = %d, body = %s", response.Code, response.Body.String())
	}
	if response := sessionRequest(e, http.MethodPut, "/api/v1/sample", nil, adminCookie, nil); response.Code != http.StatusMethodNotAllowed {
		t.Fatalf("unmatched method status = %d, body = %s", response.Code, response.Body.String())
	}
	crossHeaders := map[string]string{"Sec-Fetch-Site": "cross-site"}
	for _, request := range []struct{ method, path string }{
		{http.MethodPost, "/api/v1/sample"},
		{http.MethodPatch, "/api/v1/sample/1"},
		{http.MethodDelete, "/api/v1/sample/1"},
	} {
		if response := sessionRequest(e, request.method, request.path, nil, adminCookie, crossHeaders); response.Code != http.StatusForbidden {
			t.Fatalf("cross-site %s %s status = %d, body = %s", request.method, request.path, response.Code, response.Body.String())
		}
	}
	var rows []auth.AuditLog
	if err := db.Order("id").Find(&rows).Error; err != nil { t.Fatal(err) }
	if len(rows) != 3 || rows[0].Action != "authorize" || rows[0].Outcome != "denied" || rows[1].Action != "create" || rows[1].Outcome != "success" || rows[2].Action != "authorize" || rows[2].Resource != "unknown" {
		t.Fatalf("audit rows = %#v", rows)
	}
}

func TestSessionRateAndHashCapacityFailuresDoNotAmplifyAuditWrites(t *testing.T) {
	db := sessionTestDB(t)
	var logs bytes.Buffer
	logger := slog.New(slog.NewTextHandler(&logs, nil))
	passwords, err := auth.NewPasswordManager(auth.DefaultPasswordParams(), 1)
	if err != nil { t.Fatal(err) }
	store := auth.NewStore(db)
	createSessionTestUser(t, store, passwords, "admin@example.com", "admin", "correct horse battery staple")
	cfg := sessionTestConfig()
	cfg.AuthLoginRateLimit = 1
	e := New(cfg, db, logger{{if .Options.IsProduction}}, observability.New(nil){{end}}, store, passwords)
	first := sessionRequest(e, http.MethodPost, "/auth/login", map[string]string{"email": "missing@example.com", "password": "wrong"}, nil, nil)
	if first.Code != http.StatusUnauthorized { t.Fatalf("first login status = %d", first.Code) }
	for range 50 {
		for _, path := range []string{"/auth/login", "/auth/logout"} {
			response := sessionRequest(e, http.MethodPost, path, map[string]string{"email": "missing@example.com", "password": "wrong"}, nil, nil)
			if response.Code != http.StatusTooManyRequests { t.Fatalf("limited %s status = %d", path, response.Code) }
		}
	}

	hashCfg := sessionTestConfig()
	hashApp := New(hashCfg, db, logger{{if .Options.IsProduction}}, observability.New(nil){{end}}, store, passwords)
	permit, ok := passwords.TryAcquire()
	if !ok { t.Fatal("hash permit unavailable") }
	full := sessionRequest(hashApp, http.MethodPost, "/auth/login", map[string]string{"email": "admin@example.com", "password": "correct horse battery staple"}, nil, nil)
	permit.Release()
	if full.Code != http.StatusTooManyRequests { t.Fatalf("hash capacity status = %d", full.Code) }

	var rateRows, capacityRows int64
	if err := db.Model(&auth.AuditLog{}).Where("action = ?", "rate_limit").Count(&rateRows).Error; err != nil { t.Fatal(err) }
	if err := db.Model(&auth.AuditLog{}).Where("action = ?", "hash_capacity").Count(&capacityRows).Error; err != nil { t.Fatal(err) }
	if rateRows != 0 || capacityRows != 0 {
		t.Fatalf("rate/hash audit rows = %d/%d", rateRows, capacityRows)
	}
	var total int64
	if err := db.Model(&auth.AuditLog{}).Count(&total).Error; err != nil || total != 1 { t.Fatalf("rejections added audit rows: %d, %v", total, err) }
	if strings.Count(logs.String(), "status=429") != 101 { t.Fatal("429 request logs were lost") }
}

func TestSessionTrustedProxyClientIPs(t *testing.T) {
	db := sessionTestDB(t)
	store, passwords := auth.NewStore(db), sessionTestPasswords(t)
	createSessionTestUser(t, store, passwords, "admin@example.com", "admin", "correct horse battery staple")
	cfg := sessionTestConfig()
	cfg.AuthLoginRateLimit = 2
	_, network, _ := net.ParseCIDR("127.0.0.1/32")
	cfg.TrustedProxyCIDRs = []*net.IPNet{network}
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	e := New(cfg, db, logger{{if .Options.IsProduction}}, observability.New(nil){{end}}, store, passwords)
	for _, test := range []struct{ remote string; forwarded []string; want string }{
		{"127.0.0.1:1234", []string{"198.51.100.1"}, "198.51.100.1"},
		{"127.0.0.1:1234", []string{"203.0.113.9", "198.51.100.1"}, "198.51.100.1"},
		{"127.0.0.1:1234", []string{"203.0.113.9, 10.0.0.1"}, "10.0.0.1"},
		{"10.0.0.1:1234", []string{"203.0.113.9"}, "10.0.0.1"},
		{"198.51.100.1:1234", []string{"203.0.113.9"}, "198.51.100.1"},
		{"127.0.0.1:1234", []string{"[2001:db8::1]"}, "2001:db8::1"},
		{"127.0.0.1:1234", []string{"::ffff:192.0.2.1"}, "192.0.2.1"},
		{"127.0.0.1:1234", []string{"203.0.113.9, unknown"}, "127.0.0.1"},
	} {
		req := httptest.NewRequest(http.MethodGet, "/auth/me", nil)
		req.RemoteAddr, req.Header["X-Forwarded-For"] = test.remote, test.forwarded
		if got := e.IPExtractor(req); got != test.want { t.Fatalf("proxy %s %v = %q, want %q", test.remote, test.forwarded, got, test.want) }
	}
	request := func(ip, path string) int {
		req := httptest.NewRequest(http.MethodPost, path, strings.NewReader(`{"email":"admin@example.com","password":"correct horse battery staple"}`))
		req.RemoteAddr = "127.0.0.1:1234"
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("X-Forwarded-For", ip)
		response := httptest.NewRecorder()
		e.ServeHTTP(response, req)
		return response.Code
	}
	for i := range 6 {
		if got := request(fmt.Sprintf("198.51.100.%d", i+1), "/auth/login"); got != http.StatusOK { t.Fatalf("distinct proxied client %d: %d", i, got) }
	}
	if request("198.51.100.1", "/auth/login") != http.StatusOK || request("198.51.100.1", "/auth/logout") != http.StatusTooManyRequests { t.Fatal("same client's budget was not enforced") }
	if request("198.51.100.7", "/auth/logout") != http.StatusNoContent { t.Fatal("unrelated client was globally limited") }
	var rows int64
	if err := db.Model(&auth.Session{}).Where("ip = ?", "198.51.100.6").Count(&rows).Error; err != nil || rows != 1 { t.Fatalf("session client IP not recorded: %d, %v", rows, err) }
	cfg.TrustedProxyCIDRs = nil
	direct := New(cfg, db, logger{{if .Options.IsProduction}}, observability.New(nil){{end}}, store, passwords)
	if direct.IPExtractor != nil { t.Fatal("default mode must not trust forwarded IP headers") }
}

func TestSessionDatabaseFailureIsInternalError(t *testing.T) {
