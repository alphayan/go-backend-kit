func TestSessionLoginMeAndLogout(t *testing.T) {
	db := sessionTestDB(t)
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	passwords := sessionTestPasswords(t)
	store := auth.NewStore(db)
	createSessionTestUser(t, store, passwords, "admin@example.com", "admin", "correct horse battery staple")
	cfg := sessionTestConfig()
{{if .Options.IsProduction}}	metrics := observability.New(nil)
{{end}}	e := New(cfg, db, logger{{if .Options.IsProduction}}, metrics{{end}}, store, passwords)

	login := sessionRequest(e, http.MethodPost, "/auth/login", map[string]string{
		"email": "admin@example.com", "password": "correct horse battery staple",
	}, nil, nil)
	if login.Code != http.StatusOK {
		t.Fatalf("login status = %d, body = %s", login.Code, login.Body.String())
	}
	cookies := login.Result().Cookies()
	if len(cookies) != 1 || cookies[0].Name != "session" || !cookies[0].HttpOnly || cookies[0].SameSite != http.SameSiteLaxMode {
		t.Fatalf("login cookies = %#v", cookies)
	}
	me := sessionRequest(e, http.MethodGet, "/auth/me", nil, cookies[0], nil)
	if me.Code != http.StatusOK {
		t.Fatalf("me status = %d, body = %s", me.Code, me.Body.String())
	}
	logout := sessionRequest(e, http.MethodPost, "/auth/logout", nil, cookies[0], nil)
	if logout.Code != http.StatusNoContent {
		t.Fatalf("logout status = %d, body = %s", logout.Code, logout.Body.String())
	}
	if stale := sessionRequest(e, http.MethodGet, "/auth/me", nil, cookies[0], nil); stale.Code != http.StatusUnauthorized {
		t.Fatalf("stale session status = %d, body = %s", stale.Code, stale.Body.String())
	}
	var audits int64
	if err := db.Model(&auth.AuditLog{}).Where("resource = ?", "auth").Count(&audits).Error; err != nil {
		t.Fatal(err)
	}
	if audits < 2 {
		t.Fatalf("auth audit rows = %d, want at least 2", audits)
	}
}

func TestSessionPasswordChangeAndLoginRotation(t *testing.T) {
	db := sessionTestDB(t)
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	passwords := sessionTestPasswords(t)
	store := auth.NewStore(db)
	user := createSessionTestUser(t, store, passwords, "admin@example.com", "admin", "correct horse battery staple")
	cfg := sessionTestConfig()
{{if .Options.IsProduction}}	metrics := observability.New(nil)
{{end}}	e := New(cfg, db, logger{{if .Options.IsProduction}}, metrics{{end}}, store, passwords)

	fixationToken, err := store.CreateSession(t.Context(), user, "", "", "old browser", "127.0.0.1", time.Hour, time.Now().UTC())
	if err != nil { t.Fatal(err) }
	login := sessionRequest(e, http.MethodPost, "/auth/login", map[string]string{
		"email": user.Email, "password": "correct horse battery staple",
	}, &http.Cookie{Name: "session", Value: fixationToken}, nil)
	if login.Code != http.StatusOK {
		t.Fatalf("login status = %d, body = %s", login.Code, login.Body.String())
	}
	loginCookies := login.Result().Cookies()
	if len(loginCookies) != 1 || loginCookies[0].Value == fixationToken {
		t.Fatalf("login cookies = %#v, want a rotated token", loginCookies)
	}
	if stale := sessionRequest(e, http.MethodGet, "/auth/me", nil, &http.Cookie{Name: "session", Value: fixationToken}, nil); stale.Code != http.StatusUnauthorized {
		t.Fatalf("fixation token status = %d, body = %s", stale.Code, stale.Body.String())
	}

	otherToken, err := store.CreateSession(t.Context(), user, "", "", "other browser", "127.0.0.2", time.Hour, time.Now().UTC())
	if err != nil { t.Fatal(err) }
	wrong := sessionRequest(e, http.MethodPost, "/auth/password", map[string]string{
		"current_password": "wrong password", "new_password": "replacement password",
	}, loginCookies[0], nil)
	if wrong.Code != http.StatusUnauthorized {
		t.Fatalf("wrong current password status = %d, body = %s", wrong.Code, wrong.Body.String())
	}
	if current := sessionRequest(e, http.MethodGet, "/auth/me", nil, loginCookies[0], nil); current.Code != http.StatusOK {
		t.Fatalf("session after rejected password change = %d, body = %s", current.Code, current.Body.String())
	}

	changed := sessionRequest(e, http.MethodPost, "/auth/password", map[string]string{
		"current_password": "correct horse battery staple", "new_password": "replacement password",
	}, loginCookies[0], nil)
	if changed.Code != http.StatusNoContent {
		t.Fatalf("password change status = %d, body = %s", changed.Code, changed.Body.String())
	}
	replacementCookies := changed.Result().Cookies()
	if len(replacementCookies) != 1 || replacementCookies[0].Value == "" || replacementCookies[0].Value == loginCookies[0].Value {
		t.Fatalf("password change cookies = %#v, want a replacement token", replacementCookies)
	}
	for _, stale := range []*http.Cookie{loginCookies[0], {Name: "session", Value: otherToken}} {
		response := sessionRequest(e, http.MethodGet, "/auth/me", nil, stale, nil)
		if response.Code != http.StatusUnauthorized {
			t.Fatalf("old session %q status = %d, body = %s", stale.Value, response.Code, response.Body.String())
		}
	}
	if current := sessionRequest(e, http.MethodGet, "/auth/me", nil, replacementCookies[0], nil); current.Code != http.StatusOK {
		t.Fatalf("replacement session status = %d, body = %s", current.Code, current.Body.String())
	}

	oldPassword := sessionRequest(e, http.MethodPost, "/auth/login", map[string]string{
		"email": user.Email, "password": "correct horse battery staple",
	}, nil, nil)
	if oldPassword.Code != http.StatusUnauthorized {
		t.Fatalf("old password login status = %d, body = %s", oldPassword.Code, oldPassword.Body.String())
	}
	newPassword := sessionRequest(e, http.MethodPost, "/auth/login", map[string]string{
		"email": user.Email, "password": "replacement password",
	}, nil, nil)
	if newPassword.Code != http.StatusOK {
		t.Fatalf("new password login status = %d, body = %s", newPassword.Code, newPassword.Body.String())
	}

	var rows []auth.AuditLog
	if err := db.Where("action = ?", "password_change").Order("id").Find(&rows).Error; err != nil { t.Fatal(err) }
	if len(rows) != 2 || rows[0].Outcome != "failure" || rows[1].Outcome != "success" {
		t.Fatalf("password change audit rows = %#v", rows)
	}
	for _, row := range rows {
		for _, value := range []string{row.Action, row.Resource, row.ResourceID, row.Outcome, row.RequestID} {
			if strings.Contains(value, "correct horse battery staple") || strings.Contains(value, "replacement password") {
				t.Fatalf("audit row contains password material: %#v", row)
			}
		}
	}
}

func TestSessionLogoutIsIdempotentAndAlwaysClearsCookie(t *testing.T) {
	db := sessionTestDB(t)
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	passwords := sessionTestPasswords(t)
	store := auth.NewStore(db)
	user := createSessionTestUser(t, store, passwords, "admin@example.com", "admin", "correct horse battery staple")
	cfg := sessionTestConfig()
{{if .Options.IsProduction}}	metrics := observability.New(nil)
{{end}}	e := New(cfg, db, logger{{if .Options.IsProduction}}, metrics{{end}}, store, passwords)
	expiredToken, err := store.CreateSession(t.Context(), user, "", "", "expired browser", "127.0.0.1", -time.Minute, time.Now().UTC())
	if err != nil { t.Fatal(err) }

	for name, cookie := range map[string]*http.Cookie{
		"missing": nil,
		"unknown": {Name: "session", Value: "unknown-session-token"},
		"expired": {Name: "session", Value: expiredToken},
	} {
		t.Run(name, func(t *testing.T) {
			response := sessionRequest(e, http.MethodPost, "/auth/logout", nil, cookie, nil)
			if response.Code != http.StatusNoContent {
				t.Fatalf("logout status = %d, body = %s", response.Code, response.Body.String())
			}
			cookies := response.Result().Cookies()
			if len(cookies) != 1 || cookies[0].Name != "session" || cookies[0].MaxAge >= 0 || cookies[0].Value != "" {
				t.Fatalf("logout cookies = %#v, want an expired session cookie", cookies)
			}
		})
	}
}

