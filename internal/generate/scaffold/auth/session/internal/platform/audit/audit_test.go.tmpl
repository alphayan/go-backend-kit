package audit

import (
	"io"
	"log/slog"
	"testing"
	"time"

	"{{.Module}}/internal/platform/auth"
	"github.com/libtnb/sqlite"
	"gorm.io/gorm"
)

func TestStoreWrite(t *testing.T) {
	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
	if err != nil {
		t.Fatal(err)
	}
	if err := db.AutoMigrate(&auth.AuditLog{}); err != nil {
		t.Fatal(err)
	}
	store := NewStore(db, slog.New(slog.NewTextHandler(io.Discard, nil)))
	actor := int64(7)
	if err := store.Write(t.Context(), Event{ActorID: &actor, Action: "update", Resource: "product", ResourceID: "42", Outcome: "success", RequestID: "request-1"}); err != nil {
		t.Fatal(err)
	}
	var row auth.AuditLog
	if err := db.Take(&row).Error; err != nil {
		t.Fatal(err)
	}
	if row.ActorID == nil || *row.ActorID != actor || row.ResourceID != "42" || row.RequestID != "request-1" {
		t.Fatalf("row = %#v", row)
	}
}

func TestRetentionBoundaryAndBatchLimit(t *testing.T) {
	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
	if err != nil { t.Fatal(err) }
	sqlDB, err := db.DB()
	if err != nil { t.Fatal(err) }
	sqlDB.SetMaxOpenConns(1)
	t.Cleanup(func() { _ = sqlDB.Close() })
	if err := db.AutoMigrate(&auth.AuditLog{}); err != nil { t.Fatal(err) }
	store := NewStore(db, slog.New(slog.NewTextHandler(io.Discard, nil)))
	cutoff := time.Now().UTC().Truncate(time.Second)
	rows := make([]auth.AuditLog, 1001)
	for i := range rows { rows[i] = auth.AuditLog{Action: "test", CreatedAt: cutoff.Add(-time.Second)} }
	if err := db.CreateInBatches(rows, 100).Error; err != nil { t.Fatal(err) }
	if err := store.Write(t.Context(), Event{Action: "keep", CreatedAt: cutoff}); err != nil { t.Fatal(err) }
	store.SweepRetention(t.Context(), 0)
	var total int64
	if err := db.Model(&auth.AuditLog{}).Count(&total).Error; err != nil { t.Fatal(err) }
	if total != 1002 { t.Fatalf("disabled retention changed rows: %d", total) }
	for _, want := range []int64{1000, 1, 0} {
		count, err := store.Prune(t.Context(), cutoff)
		if err != nil || count != want { t.Fatalf("Prune = %d, %v, want %d", count, err, want) }
	}
	var remaining auth.AuditLog
	if err := db.Take(&remaining).Error; err != nil || remaining.Action != "keep" { t.Fatalf("boundary event = %#v, %v", remaining, err) }
}
