package auth

import (
	"crypto/pbkdf2"
	"crypto/sha256"
	"encoding/base64"
	"fmt"
	"strings"
	"testing"
)

func TestPasswordHashRoundTripAndBounds(t *testing.T) {
	hasher, err := NewPasswordHasher(DefaultPasswordParams())
	if err != nil {
		t.Fatal(err)
	}
	encoded, err := hasher.Hash("correct horse battery staple")
	if err != nil {
		t.Fatal(err)
	}
	valid, rehash, err := hasher.Verify(encoded, "correct horse battery staple")
	if err != nil || !valid || rehash {
		t.Fatalf("Verify() = %v, %v, %v", valid, rehash, err)
	}
	valid, _, err = hasher.Verify(encoded, "wrong")
	if err != nil || valid {
		t.Fatalf("wrong password Verify() = %v, %v", valid, err)
	}
	salt := base64.RawStdEncoding.EncodeToString(make([]byte, passwordSaltBytes))
	digest := base64.RawStdEncoding.EncodeToString(make([]byte, passwordHashBytes))
	_, _, err = hasher.Verify("argon2id$v=19$m=999999,t=2,p=1$"+salt+"$"+digest, "x")
	if err == nil || !strings.Contains(err.Error(), "parameters") {
		t.Fatalf("out-of-bounds encoding error = %v", err)
	}
}

func TestPBKDF2VerificationRequestsArgon2idRehash(t *testing.T) {
	hasher, err := NewPasswordHasher(DefaultPasswordParams())
	if err != nil { t.Fatal(err) }
	salt := []byte("0123456789abcdef")
	digest, err := pbkdf2.Key(sha256.New, "legacy password", salt, 100000, passwordHashBytes)
	if err != nil { t.Fatal(err) }
	encoded := fmt.Sprintf("pbkdf2-sha256$i=100000$%s$%s", base64.RawStdEncoding.EncodeToString(salt), base64.RawStdEncoding.EncodeToString(digest))
	valid, rehash, err := hasher.Verify(encoded, "legacy password")
	if err != nil || !valid || !rehash {
		t.Fatalf("Verify() = %v, %v, %v", valid, rehash, err)
	}
}

func TestArgon2ParameterChangeRequestsRehash(t *testing.T) {
	oldHasher, err := NewPasswordHasher(PasswordParams{MemoryKiB: 12288, Time: 3, Parallelism: 1})
	if err != nil { t.Fatal(err) }
	encoded, err := oldHasher.Hash("password")
	if err != nil { t.Fatal(err) }
	current, err := NewPasswordHasher(DefaultPasswordParams())
	if err != nil { t.Fatal(err) }
	valid, rehash, err := current.Verify(encoded, "password")
	if err != nil || !valid || !rehash {
		t.Fatalf("Verify() = %v, %v, %v", valid, rehash, err)
	}
}

func TestPasswordManagerRejectsQueueing(t *testing.T) {
	manager, err := NewPasswordManager(DefaultPasswordParams(), 1)
	if err != nil {
		t.Fatal(err)
	}
	permit, ok := manager.TryAcquire()
	if !ok {
		t.Fatal("first permit unavailable")
	}
	defer permit.Release()
	if _, ok := manager.TryAcquire(); ok {
		t.Fatal("second permit queued instead of rejecting")
	}
}

// BenchmarkPassword measures the real encoding/verification paths, not HTTP or
// admission control. RunParallel uses GOMAXPROCS workers; use -cpu=1,4 explicitly
// since every active Argon2id call allocates its own memory-hard working buffer.
func BenchmarkPassword(b *testing.B) {
	const password = "benchmark password, not a real credential"
	hasher, err := NewPasswordHasher(DefaultPasswordParams())
	if err != nil { b.Fatal(err) }
	encoded, err := hasher.Hash(password)
	if err != nil { b.Fatal(err) }
	salt := []byte("0123456789abcdef")
	digest, err := pbkdf2.Key(sha256.New, password, salt, 600000, passwordHashBytes)
	if err != nil { b.Fatal(err) }
	legacy := fmt.Sprintf("pbkdf2-sha256$i=600000$%s$%s", base64.RawStdEncoding.EncodeToString(salt), base64.RawStdEncoding.EncodeToString(digest))
	for _, test := range []struct {
		name string
		run func() error
	}{
		{"Argon2idHash", func() error {
			result, err := hasher.Hash(password)
			if err == nil && result == "" { return fmt.Errorf("Hash returned an empty encoding") }
			return err
		}},
		{"Argon2idVerify", func() error {
			valid, rehash, err := hasher.Verify(encoded, password)
			if err == nil && (!valid || rehash) { return fmt.Errorf("Verify returned valid=%v rehash=%v", valid, rehash) }
			return err
		}},
		{"PBKDF2Verify", func() error {
			valid, rehash, err := hasher.Verify(legacy, password)
			if err == nil && (!valid || !rehash) { return fmt.Errorf("legacy Verify returned valid=%v rehash=%v", valid, rehash) }
			return err
		}},
	} {
		b.Run(test.name+"/serial", func(b *testing.B) {
			b.ReportAllocs()
			for b.Loop() {
				if err := test.run(); err != nil { b.Fatal(err) }
			}
		})
		b.Run(test.name+"/parallel", func(b *testing.B) {
			b.ReportAllocs()
			b.RunParallel(func(pb *testing.PB) {
				for pb.Next() {
					if err := test.run(); err != nil {
						b.Error(err)
						return
					}
				}
			})
		})
	}
}
