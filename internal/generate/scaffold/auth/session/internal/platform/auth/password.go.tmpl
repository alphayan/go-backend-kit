package auth

import (
	"crypto/pbkdf2"
	"crypto/rand"
	"crypto/sha256"
	"crypto/subtle"
	"encoding/base64"
	"errors"
	"fmt"
	"strconv"
	"strings"
	"sync"

	"golang.org/x/crypto/argon2"
)

const (
	passwordSaltBytes = 16
	passwordHashBytes = 32
)

var ErrHashCapacity = errors.New("password hash capacity exhausted")

type PasswordParams struct {
	MemoryKiB   uint32
	Time        uint32
	Parallelism uint8
}

func DefaultPasswordParams() PasswordParams {
	return PasswordParams{MemoryKiB: 19456, Time: 2, Parallelism: 1}
}

func (p PasswordParams) Validate() error {
	if p.MemoryKiB < 7168 || p.MemoryKiB > 65536 || p.Time < 1 || p.Time > 10 || p.Parallelism < 1 || p.Parallelism > 16 {
		return errors.New("Argon2id parameters must stay within m=7168..65536 KiB, t=1..10, p=1..16")
	}
	recommended := [...]PasswordParams{
		{MemoryKiB: 47104, Time: 1, Parallelism: 1},
		{MemoryKiB: 19456, Time: 2, Parallelism: 1},
		{MemoryKiB: 12288, Time: 3, Parallelism: 1},
		{MemoryKiB: 9216, Time: 4, Parallelism: 1},
		{MemoryKiB: 7168, Time: 5, Parallelism: 1},
	}
	for _, candidate := range recommended {
		if p.MemoryKiB >= candidate.MemoryKiB && p.Time >= candidate.Time && p.Parallelism >= candidate.Parallelism {
			return nil
		}
	}
	return errors.New("Argon2id parameters must match or dominate an OWASP published configuration: m=47104,t=1,p=1; m=19456,t=2,p=1; m=12288,t=3,p=1; m=9216,t=4,p=1; m=7168,t=5,p=1")
}

type PasswordHasher struct{ params PasswordParams }

func NewPasswordHasher(params PasswordParams) (*PasswordHasher, error) {
	if err := params.Validate(); err != nil {
		return nil, err
	}
	return &PasswordHasher{params: params}, nil
}

func (h *PasswordHasher) Hash(password string) (string, error) {
	salt := make([]byte, passwordSaltBytes)
	if _, err := rand.Read(salt); err != nil {
		return "", fmt.Errorf("read password salt: %w", err)
	}
	digest := argon2.IDKey([]byte(password), salt, h.params.Time, h.params.MemoryKiB, h.params.Parallelism, passwordHashBytes)
	return fmt.Sprintf("argon2id$v=19$m=%d,t=%d,p=%d$%s$%s", h.params.MemoryKiB, h.params.Time, h.params.Parallelism,
		base64.RawStdEncoding.EncodeToString(salt), base64.RawStdEncoding.EncodeToString(digest)), nil
}

func (h *PasswordHasher) Verify(encoded, password string) (valid, needsRehash bool, err error) {
	switch {
	case strings.HasPrefix(encoded, "argon2id$"):
		params, salt, expected, parseErr := parseArgon2id(encoded)
		if parseErr != nil {
			return false, false, parseErr
		}
		actual := argon2.IDKey([]byte(password), salt, params.Time, params.MemoryKiB, params.Parallelism, passwordHashBytes)
		return subtle.ConstantTimeCompare(actual, expected) == 1, params != h.params, nil
	case strings.HasPrefix(encoded, "pbkdf2-sha256$"):
		iterations, salt, expected, parseErr := parsePBKDF2(encoded)
		if parseErr != nil {
			return false, false, parseErr
		}
		actual, deriveErr := pbkdf2.Key(sha256.New, password, salt, iterations, passwordHashBytes)
		if deriveErr != nil {
			return false, false, deriveErr
		}
		return subtle.ConstantTimeCompare(actual, expected) == 1, true, nil
	default:
		return false, false, errors.New("unsupported password hash encoding")
	}
}

func parseArgon2id(encoded string) (PasswordParams, []byte, []byte, error) {
	parts := strings.Split(encoded, "$")
	if len(parts) != 5 || parts[0] != "argon2id" || parts[1] != "v=19" {
		return PasswordParams{}, nil, nil, errors.New("invalid Argon2id encoding")
	}
	fields := strings.Split(parts[2], ",")
	if len(fields) != 3 || !strings.HasPrefix(fields[0], "m=") || !strings.HasPrefix(fields[1], "t=") || !strings.HasPrefix(fields[2], "p=") {
		return PasswordParams{}, nil, nil, errors.New("invalid Argon2id parameters")
	}
	memory, memoryErr := strconv.ParseUint(strings.TrimPrefix(fields[0], "m="), 10, 32)
	iterations, timeErr := strconv.ParseUint(strings.TrimPrefix(fields[1], "t="), 10, 32)
	parallel, parallelErr := strconv.ParseUint(strings.TrimPrefix(fields[2], "p="), 10, 8)
	if memoryErr != nil || timeErr != nil || parallelErr != nil ||
		memory < 7168 || memory > 65536 || iterations < 1 || iterations > 10 || parallel < 1 || parallel > 16 {
		return PasswordParams{}, nil, nil, errors.New("invalid Argon2id parameters")
	}
	salt, digest, err := decodePasswordParts(parts[3], parts[4])
	if err != nil {
		return PasswordParams{}, nil, nil, err
	}
	return PasswordParams{MemoryKiB: uint32(memory), Time: uint32(iterations), Parallelism: uint8(parallel)}, salt, digest, nil
}

func parsePBKDF2(encoded string) (int, []byte, []byte, error) {
	parts := strings.Split(encoded, "$")
	if len(parts) != 4 || parts[0] != "pbkdf2-sha256" || !strings.HasPrefix(parts[1], "i=") {
		return 0, nil, nil, errors.New("invalid PBKDF2 encoding")
	}
	iterations, err := strconv.Atoi(strings.TrimPrefix(parts[1], "i="))
	if err != nil || iterations < 100000 || iterations > 10000000 {
		return 0, nil, nil, errors.New("invalid PBKDF2 iterations")
	}
	salt, digest, err := decodePasswordParts(parts[2], parts[3])
	if err != nil {
		return 0, nil, nil, err
	}
	return iterations, salt, digest, nil
}

func decodePasswordParts(rawSalt, rawDigest string) ([]byte, []byte, error) {
	salt, err := base64.RawStdEncoding.Strict().DecodeString(rawSalt)
	if err != nil || len(salt) != passwordSaltBytes {
		return nil, nil, errors.New("invalid password salt")
	}
	digest, err := base64.RawStdEncoding.Strict().DecodeString(rawDigest)
	if err != nil || len(digest) != passwordHashBytes {
		return nil, nil, errors.New("invalid password digest")
	}
	return salt, digest, nil
}

type PasswordManager struct {
	hasher *PasswordHasher
	dummy  string
	gate   chan struct{}
}

func NewPasswordManager(params PasswordParams, concurrency int) (*PasswordManager, error) {
	if concurrency < 1 || concurrency > 64 {
		return nil, errors.New("password hash concurrency must be between 1 and 64")
	}
	hasher, err := NewPasswordHasher(params)
	if err != nil {
		return nil, err
	}
	dummy, err := hasher.Hash("gobackend-fixed-dummy-password")
	if err != nil {
		return nil, err
	}
	return &PasswordManager{hasher: hasher, dummy: dummy, gate: make(chan struct{}, concurrency)}, nil
}

func (m *PasswordManager) TryAcquire() (*PasswordPermit, bool) {
	select {
	case m.gate <- struct{}{}:
		return &PasswordPermit{manager: m}, true
	default:
		return nil, false
	}
}

type PasswordPermit struct {
	manager *PasswordManager
	once    sync.Once
}

func (p *PasswordPermit) Release() {
	p.once.Do(func() { <-p.manager.gate })
}

func (p *PasswordPermit) Hash(password string) (string, error) {
	return p.manager.hasher.Hash(password)
}

func (p *PasswordPermit) Verify(encoded, password string) (bool, bool, error) {
	return p.manager.hasher.Verify(encoded, password)
}

func (p *PasswordPermit) DummyEncoding() string { return p.manager.dummy }
