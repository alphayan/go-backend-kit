package auth

import (
	"bytes"
	"context"
	"fmt"
	"os"
	"os/exec"
	"regexp"
	"strconv"
	"sync"
	"testing"
	"time"

	"gorm.io/driver/postgres"
	"gorm.io/gorm"
	gormlogger "gorm.io/gorm/logger"
)

// Requires an explicitly disposable, already migrated database. Run separately
// from app tests: this test fills/deletes auth_rate_limits to exercise capacity.
func TestPostgresSharedLimiter(t *testing.T) {
	if os.Getenv("TEST_RATE_DATABASE_URL") == "" || os.Getenv("TEST_RATE_DISPOSABLE") != "1" {
		t.Skip("TEST_RATE_DATABASE_URL and TEST_RATE_DISPOSABLE=1 are required")
	}
	db, err := gorm.Open(postgres.Open(os.Getenv("TEST_RATE_DATABASE_URL")), &gorm.Config{Logger: gormlogger.Default.LogMode(gormlogger.Silent)})
	if err != nil { t.Fatal("open disposable rate-limit database:", err) }
	sqlDB, err := db.DB()
	if err != nil { t.Fatal(err) }
	sqlDB.SetMaxOpenConns(4)
	t.Cleanup(func() { _ = sqlDB.Close() })
	limiter := NewLoginLimiter(NewStore(db), 2, time.Minute)
	if mode := os.Getenv("RATE_TEST_CHILD"); mode != "" {
		var wg sync.WaitGroup
		results := make(chan bool, 16)
		for i := range 16 {
			wg.Go(func() {
				ip, email := "shared-ip", ""
				if mode == "email" { ip, email = fmt.Sprintf("%d-%d", os.Getpid(), i), " Shared@Example.test " }
				// Deliberately skew client clocks: only the database clock may expire a bucket.
				allowed, err := limiter.Allow(t.Context(), ip, email, time.Now().Add(24*time.Hour))
				if err != nil { t.Error(err) }
				results <- allowed
			})
		}
		wg.Wait()
		close(results)
		count := 0
		for allowed := range results { if allowed { count++ } }
		fmt.Printf("admitted=%d\n", count)
		return
	}
	clear := func() {
		t.Helper()
		if err := db.Where("1 = 1").Delete(&RateLimit{}).Error; err != nil { t.Fatal(err) }
	}
	clear()
	t.Cleanup(clear)
	for _, mode := range []string{"ip", "email"} {
		clear()
		commands := make([]*exec.Cmd, 2)
		outputs := make([]bytes.Buffer, 2)
		for i := range commands {
			commands[i] = exec.CommandContext(t.Context(), os.Args[0], "-test.run=^TestPostgresSharedLimiter$", "-test.timeout=30s")
			commands[i].Env = append(os.Environ(), "RATE_TEST_CHILD="+mode)
			commands[i].Stdout, commands[i].Stderr = &outputs[i], &outputs[i]
			if err := commands[i].Start(); err != nil { t.Fatal(err) }
		}
		total := 0
		for i, command := range commands {
			if err := command.Wait(); err != nil { t.Fatalf("child failed: %v\n%s", err, &outputs[i]) }
			match := regexp.MustCompile(`admitted=(\d+)`).FindStringSubmatch(outputs[i].String())
			if len(match) != 2 { t.Fatalf("missing child result: %s", &outputs[i]) }
			count, _ := strconv.Atoi(match[1])
			total += count
		}
		want := 2
		if mode == "email" { want = 6 }
		if total != want { t.Fatalf("two processes admitted %d %s attempts, want %d", total, mode, want) }
		if mode == "ip" {
			if allowed, err := limiter.Allow(t.Context(), "shared-ip", "", time.Now().Add(72*time.Hour)); err != nil || allowed {
				t.Fatalf("fresh limiter / skewed application clock bypassed shared quota: %v, %v", allowed, err)
			}
		}
	}
	if err := limiter.ClearEmail(t.Context(), "shared@example.test"); err != nil { t.Fatal(err) }
	if allowed, err := limiter.Allow(t.Context(), "after-success", "shared@example.test", time.Time{}); err != nil || !allowed {
		t.Fatalf("clear email: allowed=%v, err=%v", allowed, err)
	}
	clear()
	// Fill the IP keyspace without 10,000 network round trips. Saturation must
	// reject NEW identities, not evict an existing identity's exhausted budget.
	rows := make([]RateLimit, rateLimitKeyCapacity)
	for i := range rows { rows[i] = RateLimit{Kind: "ip", KeyDigest: rateKeyDigest(fmt.Sprint(i)), Count: 2, ExpiresAt: time.Now().Add(time.Hour)} }
	if err := db.CreateInBatches(rows, 500).Error; err != nil { t.Fatal(err) }
	for _, key := range []string{"0", "new-key"} {
		if allowed, err := limiter.Allow(t.Context(), key, "", time.Now()); err != nil || allowed {
			t.Fatalf("full keyspace allowed %q: %v, %v", key, allowed, err)
		}
	}
	var count int64
	if err := db.Model(&RateLimit{}).Count(&count).Error; err != nil || count != rateLimitKeyCapacity { t.Fatalf("bounded rows=%d: %v", count, err) }
	if err := db.Model(&RateLimit{}).Where("1 = 1").Update("expires_at", time.Unix(0, 0)).Error; err != nil { t.Fatal(err) }
	if allowed, err := limiter.Allow(t.Context(), "new-key", "", time.Now()); err != nil || !allowed { t.Fatalf("expiry: %v, %v", allowed, err) }
	if err := db.Model(&RateLimit{}).Count(&count).Error; err != nil || count != 1 { t.Fatalf("expired rows=%d: %v", count, err) }
	// Prove lock waits obey cancellation and leave no reservation behind.
	tx := db.Begin()
	if tx.Error != nil { t.Fatal(tx.Error) }
	if err := tx.Exec("LOCK TABLE auth_rate_limits IN EXCLUSIVE MODE").Error; err != nil { _ = tx.Rollback(); t.Fatal(err) }
	ctx, cancel := context.WithTimeout(t.Context(), 100*time.Millisecond)
	allowed, waitErr := limiter.Allow(ctx, "cancelled", "", time.Now())
	cancel()
	if err := tx.Rollback().Error; err != nil { t.Fatal(err) }
	if waitErr == nil || allowed { t.Fatalf("lock cancellation: allowed=%v, err=%v", allowed, waitErr) }
	if err := db.Model(&RateLimit{}).Where("key_digest = ?", rateKeyDigest("cancelled")).Count(&count).Error; err != nil || count != 0 { t.Fatalf("cancelled reservation rows=%d: %v", count, err) }
	clear()
	closedDB, err := gorm.Open(postgres.Open(os.Getenv("TEST_RATE_DATABASE_URL")), &gorm.Config{Logger: gormlogger.Default.LogMode(gormlogger.Silent)})
	if err != nil { t.Fatal(err) }
	closedPool, err := closedDB.DB()
	if err != nil { t.Fatal(err) }
	if err := closedPool.Close(); err != nil { t.Fatal(err) }
	broken := NewLoginLimiter(NewStore(closedDB), 2, time.Minute)
	if allowed, err := broken.Allow(t.Context(), "unavailable", "", time.Now()); err == nil || allowed { t.Fatalf("database failure allowed=%v, err=%v", allowed, err) }
}
