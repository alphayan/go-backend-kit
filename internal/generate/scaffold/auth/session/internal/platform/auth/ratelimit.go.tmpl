const rateLimitKeyCapacity = 10000

type LoginLimiter struct {
	store *Store
	ip    *fixedWindowLRU
	email *fixedWindowLRU
}

func NewLoginLimiter(store *Store, limit int, window time.Duration) *LoginLimiter {
	if limit < 1 {
		limit = 1
	}
	if window <= 0 {
		window = 15 * time.Minute
	}
	emailLimit := limit * 3
	if emailLimit < limit+1 {
		emailLimit = limit + 1
	}
	return &LoginLimiter{
		store: store,
		ip:    newFixedWindowLRU(limit, window, rateLimitKeyCapacity),
		email: newFixedWindowLRU(emailLimit, window, rateLimitKeyCapacity),
	}
}

// Allow reserves before password verification so concurrent requests cannot
// all pass an availability check before any of them records a failure.
// An empty email consumes only the IP budget (logout).
func (l *LoginLimiter) Allow(ctx context.Context, ip, email string, now time.Time) (bool, error) {
	if err := ctx.Err(); err != nil { return false, err }
	ip, email = strings.TrimSpace(ip), normalizeEmail(email)
