#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
{{if .Options.IsProduction}}# A schema diff against the disposable dev database needs no target credentials.
case "${1:-}:${2:-}" in
  migrate:diff|migrate:hash|migrate:validate) ;;
  *) : "${ATLAS_DATABASE_URL:?Set ATLAS_DATABASE_URL to the migration role; runtime DATABASE_URL is not used}" ;;
esac
{{end}}
mkdir -p .gobackend
schema=.gobackend/schema.sql
dev_container=""
cleanup() {
  if [ -n "$dev_container" ]; then
    docker rm -fv "$dev_container" >/dev/null 2>&1 || true
  fi
  rm -f "$schema"
}
trap cleanup EXIT HUP INT TERM
go run ./tools/gormschema > "$schema"

dev_container_name="gobackend-atlas-dev-$$"
created_dev_container=$(docker run -d --name "$dev_container_name" \
  -e POSTGRES_PASSWORD=atlas \
  -p 127.0.0.1::5432 {{.Pins.PostgresImage}})
dev_container=$created_dev_container
attempts=0
until docker exec "$dev_container" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1; do
  attempts=$((attempts + 1))
  if [ "$attempts" -ge 30 ]; then
    echo "Atlas development database did not become ready" >&2
    exit 1
  fi
  sleep 1
done
dev_port=$(docker port "$dev_container" 5432/tcp | head -n 1 | awk -F: '{print $NF}')
atlas_host=host.docker.internal
network_option=--add-host=host.docker.internal:host-gateway
if [ "$(uname -s)" = Linux ]; then
  atlas_host=127.0.0.1
  network_option=--network=host
fi
container_dev_url="postgres://postgres:atlas@${atlas_host}:${dev_port}/postgres?sslmode=disable"

container_database_url={{if .Options.IsProduction}}${ATLAS_DATABASE_URL:-}{{else}}${ATLAS_DATABASE_URL:-${DATABASE_URL:-}}{{end}}
container_database_url=$(printf '%s' "$container_database_url" | sed \
  -e "s/@localhost:/@${atlas_host}:/g" \
  -e "s/@127\\.0\\.0\\.1:/@${atlas_host}:/g")

DATABASE_URL=$container_database_url ATLAS_DEV_URL=$container_dev_url docker run --rm \
  --user "$(id -u):$(id -g)" -e HOME=/tmp \
  "$network_option" \
  -e DATABASE_URL \
  -e ATLAS_DEV_URL \
  -v "$root:/workspace" \
  -w /workspace \
  {{.Pins.AtlasImage}} "$@"
