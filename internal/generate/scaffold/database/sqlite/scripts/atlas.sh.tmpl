#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
mkdir -p .gobackend data
schema=.gobackend/schema.sql
dev_db=".gobackend/atlas-dev-$$.db"
cleanup() {
  rm -f "$schema" "$dev_db" "${dev_db}-wal" "${dev_db}-shm" "${dev_db}-journal"
}
trap cleanup EXIT HUP INT TERM
go run ./tools/gormschema > "$schema"

app_db=${ATLAS_DATABASE_URL:-sqlite:///workspace/data/app.db?mode=rwc}

docker run --rm \
  -e "DATABASE_URL=$app_db" \
  -e "ATLAS_DEV_URL=sqlite:///workspace/${dev_db}?mode=rwc" \
  -v "$root:/workspace" \
  -w /workspace \
  {{.Pins.AtlasImage}} "$@"
