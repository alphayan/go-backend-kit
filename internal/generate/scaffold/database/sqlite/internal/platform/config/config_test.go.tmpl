func TestLoadRequiresJWTSettings(t *testing.T) {
	tests := []struct {
		name string
		key  string
		want string
	}{
		{"secret", "AUTH_JWT_SECRET_B64", "AUTH_JWT_SECRET_B64 is required"},
		{"issuer", "AUTH_JWT_ISSUER", "AUTH_JWT_ISSUER is required"},
		{"audience", "AUTH_JWT_AUDIENCE", "AUTH_JWT_AUDIENCE is required"},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			values := baseEnv()
			values[test.key] = ""
			_, err := load(lookup(values))
			if err == nil || !strings.Contains(err.Error(), test.want) {
				t.Fatalf("error = %v, want %q", err, test.want)
			}
		})
	}
}
