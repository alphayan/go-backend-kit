func New(cfg config.Config, db *gorm.DB, logger *slog.Logger{{if .Options.HasJWT}}, verifier *auth.Verifier{{end}}{{if .Options.HasRedis}}, redisClient *redis.Client{{end}}{{if .Options.HasNATS}}, natsConn *nats.Conn{{end}}) *echo.Echo {
	e := echo.NewWithConfig(echo.Config{Logger: logger})
	e.HTTPErrorHandler = func(c *echo.Context, err error) { _ = httpx.WriteError(c, err) }
	e.Use(middleware.RequestID())
	e.Use(middleware.Recover())
	e.Use(middleware.BodyLimit(1 << 20))
	e.Use(middleware.ContextTimeout(cfg.RequestTimeout))
	e.Use(middleware.Secure())
	if len(cfg.CORSOrigins) > 0 {
		e.Use(middleware.CORS(cfg.CORSOrigins...))
	}
	e.Use(requestLogger(logger))

	e.GET("/health/live", func(c *echo.Context) error {
		return httpx.WriteData(c, http.StatusOK, map[string]string{"status": "ok"})
	})
	e.GET("/health/ready", func(c *echo.Context) error {
		ctx := c.Request().Context()
		sqlDB, err := db.DB()
		if err != nil || sqlDB.PingContext(ctx) != nil {
			return httpx.WriteError(c, echo.ErrServiceUnavailable)
		}
{{if .Options.HasRedis}}		if err := redisClient.Ping(ctx).Err(); err != nil {
			return httpx.WriteError(c, echo.ErrServiceUnavailable)
		}
{{end}}{{if .Options.HasNATS}}		if err := ctx.Err(); err != nil {
			return httpx.WriteError(c, echo.ErrServiceUnavailable)
		}
		timeout := 2 * time.Second
		if deadline, ok := ctx.Deadline(); ok {
			if remaining := time.Until(deadline); remaining < timeout {
				timeout = remaining
			}
		}
		if timeout <= 0 || natsConn.FlushTimeout(timeout) != nil {
			return httpx.WriteError(c, echo.ErrServiceUnavailable)
		}
{{end}}		return httpx.WriteData(c, http.StatusOK, map[string]string{"status": "ready"})
	})
	e.GET("/openapi.json", func(c *echo.Context) error {
		return c.JSONBlob(http.StatusOK, openapi.Spec)
	})
	docs := echo.WrapHandler(v5emb.New("Generated Backend API", "/openapi.json", "/docs"))
	e.GET("/docs", docs)
	e.GET("/docs/*", docs)
	api := e.Group("/api/v1")
{{if .Options.HasJWT}}	api.Use(jwtMiddleware(verifier))
{{end}}	generated.Register(api, db)
	return e
}

func requestLogger(logger *slog.Logger) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c *echo.Context) error {
			start := time.Now()
			err := next(c)
			_, status := echo.ResolveResponseStatus(c.Response(), err)
			logger.LogAttrs(c.Request().Context(), slog.LevelInfo, "http_request",
				slog.String("method", c.Request().Method),
				slog.String("path", c.Request().URL.Path),
				slog.Int("status", status),
				slog.String("request_id", c.Response().Header().Get("X-Request-ID")),
				slog.Int64("duration_ms", time.Since(start).Milliseconds()),
			)
			return err
		}
	}
}
{{if .Options.HasJWT}}
func jwtMiddleware(verifier *auth.Verifier) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c *echo.Context) error {
			token, ok := bearerToken(c.Request().Header.Get("Authorization"))
			if !ok {
				return httpx.WriteError(c, apperror.Unauthorized())
			}
			identity, err := verifier.Verify(token)
			if err != nil {
				return httpx.WriteError(c, apperror.Unauthorized())
			}
			request := c.Request().WithContext(auth.WithIdentity(c.Request().Context(), identity))
			c.SetRequest(request)
			return next(c)
		}
	}
}

func bearerToken(header string) (string, bool) {
	const prefix = "Bearer "
	if !strings.HasPrefix(header, prefix) {
		return "", false
	}
	token := strings.TrimSpace(strings.TrimPrefix(header, prefix))
	if token == "" || strings.ContainsAny(token, " \t") {
		return "", false
	}
	return token, true
}
