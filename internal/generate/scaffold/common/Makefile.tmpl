.PHONY: generate check test vet vuln migration migrate-apply run{{if .Options.HasSession}} frontend-install frontend-dev frontend-typecheck frontend-test frontend-build frontend-e2e{{end}}{{if .Options.IsProduction}} up down logs compose-config{{end}}

generate:
	go tool gobackend generate

check:
	go tool gobackend check

test:
	go test -race ./...

vet:
	go vet ./...

vuln:
	go tool govulncheck ./...

migration:
	@test -n "$(name)" || (echo "usage: make migration name=create_tasks" && exit 1)
	./scripts/atlas.sh migrate diff "$(name)" --env local

migrate-apply:
	./scripts/atlas.sh migrate apply --env ci

run:
	go run ./cmd/api
{{if .Options.HasSession}}
frontend-install:
	pnpm install --frozen-lockfile

frontend-dev:
	pnpm frontend:dev

frontend-typecheck:
	pnpm frontend:typecheck

frontend-test:
	pnpm frontend:test

frontend-build:
	pnpm frontend:build

frontend-e2e:
	pnpm frontend:e2e
{{end}}
{{if .Options.IsProduction}}
up:
	@test -f .env || (echo "copy .env.example to .env first" && exit 1)
	docker compose up -d --build

down:
	docker compose down

logs:
	docker compose logs -f --no-log-prefix api

compose-config:
	docker compose config --quiet
{{end}}
