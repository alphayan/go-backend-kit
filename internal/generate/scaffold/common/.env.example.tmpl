HTTP_ADDRESS=:8080
{{if .Options.IsPostgres}}DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
{{end}}{{if .Options.IsSQLite}}DATABASE_PATH=data/app.db
{{end}}DB_CONNECT_TIMEOUT=5s
CORS_ORIGINS=http://localhost:3000
{{if .Options.HasRedis}}REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT=5s
{{end}}{{if .Options.HasNATS}}NATS_URL=nats://127.0.0.1:4222
NATS_CONNECT_TIMEOUT=5s
NATS_FLUSH_TIMEOUT=2s
NATS_DRAIN_TIMEOUT=5s
{{end}}{{if .Options.HasJWT}}AUTH_JWT_SECRET_B64=
AUTH_JWT_ISSUER=example-issuer
AUTH_JWT_AUDIENCE=example-audience
AUTH_JWT_LEEWAY=30s
{{end}}
