func Load() (Config, error) { return load(os.Getenv) }

func load(getenv envLookup) (Config, error) {
	cfg := Config{
		Address:        envOr(getenv, "HTTP_ADDRESS", ":8080"),
{{if .Options.IsProduction}}		ServiceName:    envOr(getenv, "SERVICE_NAME", "generated-api"),
		Environment:    envOr(getenv, "ENVIRONMENT", "development"),
		BuildVersion:   envOr(getenv, "BUILD_VERSION", "dev"),
{{end}}		RequestTimeout: 15 * time.Second,
	}
	if raw := strings.TrimSpace(getenv("CORS_ORIGINS")); raw != "" {
		for origin := range strings.SplitSeq(raw, ",") {
			if origin = strings.TrimSpace(origin); origin != "" {
				cfg.CORSOrigins = append(cfg.CORSOrigins, origin)
			}
		}
	}
{{if .Options.IsPostgres}}	maxOpen, err := intEnv(getenv, "DB_MAX_OPEN_CONNS", 25)
	if err != nil {
		return Config{}, err
	}
	maxIdle, err := intEnv(getenv, "DB_MAX_IDLE_CONNS", 25)
	if err != nil {
		return Config{}, err
	}
	maxLifetime, err := durationEnv(getenv, "DB_CONN_MAX_LIFETIME", 30*time.Minute)
	if err != nil {
		return Config{}, err
	}
	maxIdleTime, err := durationEnv(getenv, "DB_CONN_MAX_IDLE_TIME", 5*time.Minute)
	if err != nil {
		return Config{}, err
	}
	connectTimeout, err := durationEnv(getenv, "DB_CONNECT_TIMEOUT", 5*time.Second)
	if err != nil {
		return Config{}, err
	}
	if maxOpen <= 0 {
		return Config{}, errors.New("DB_MAX_OPEN_CONNS must be greater than zero")
	}
	if maxIdle < 0 {
		return Config{}, errors.New("DB_MAX_IDLE_CONNS cannot be negative")
	}
	if maxIdle > maxOpen {
		return Config{}, errors.New("DB_MAX_IDLE_CONNS cannot exceed DB_MAX_OPEN_CONNS")
	}
	if maxLifetime < 0 {
		return Config{}, errors.New("DB_CONN_MAX_LIFETIME cannot be negative")
	}
	if maxIdleTime < 0 {
		return Config{}, errors.New("DB_CONN_MAX_IDLE_TIME cannot be negative")
	}
	if connectTimeout <= 0 {
		return Config{}, errors.New("DB_CONNECT_TIMEOUT must be greater than zero")
	}
	cfg.DatabaseURL = getenv("DATABASE_URL")
	cfg.DatabaseMaxOpenConnections = maxOpen
	cfg.DatabaseMaxIdleConnections = maxIdle
	cfg.DatabaseConnectionMaxLifetime = maxLifetime
	cfg.DatabaseConnectionMaxIdleTime = maxIdleTime
	cfg.DatabaseConnectTimeout = connectTimeout
	if cfg.DatabaseURL == "" {
		return Config{}, errors.New("DATABASE_URL is required")
	}
{{end}}{{if .Options.IsSQLite}}	connectTimeout, err := durationEnv(getenv, "DB_CONNECT_TIMEOUT", 5*time.Second)
	if err != nil {
		return Config{}, err
	}
	if connectTimeout <= 0 {
		return Config{}, errors.New("DB_CONNECT_TIMEOUT must be greater than zero")
	}
	cfg.DatabasePath = envOr(getenv, "DATABASE_PATH", "data/app.db")
	cfg.DatabaseConnectTimeout = connectTimeout
	if strings.TrimSpace(cfg.DatabasePath) == "" {
		return Config{}, errors.New("DATABASE_PATH is required")
	}
{{end}}{{if .Options.HasRedis}}	redisTimeout, err := durationEnv(getenv, "REDIS_CONNECT_TIMEOUT", 5*time.Second)
	if err != nil {
		return Config{}, err
	}
	if redisTimeout <= 0 {
		return Config{}, errors.New("REDIS_CONNECT_TIMEOUT must be greater than zero")
	}
	cfg.RedisURL = getenv("REDIS_URL")
	cfg.RedisConnectTimeout = redisTimeout
	if cfg.RedisURL == "" {
		return Config{}, errors.New("REDIS_URL is required")
	}
{{end}}{{if .Options.HasNATS}}	natsConnect, err := durationEnv(getenv, "NATS_CONNECT_TIMEOUT", 5*time.Second)
	if err != nil {
		return Config{}, err
	}
	natsFlush, err := durationEnv(getenv, "NATS_FLUSH_TIMEOUT", 2*time.Second)
	if err != nil {
		return Config{}, err
	}
	natsDrain, err := durationEnv(getenv, "NATS_DRAIN_TIMEOUT", 5*time.Second)
	if err != nil {
		return Config{}, err
	}
	if natsConnect <= 0 {
		return Config{}, errors.New("NATS_CONNECT_TIMEOUT must be greater than zero")
	}
	if natsFlush <= 0 {
		return Config{}, errors.New("NATS_FLUSH_TIMEOUT must be greater than zero")
	}
	if natsDrain <= 0 {
		return Config{}, errors.New("NATS_DRAIN_TIMEOUT must be greater than zero")
	}
	cfg.NATSURL = getenv("NATS_URL")
	cfg.NATSConnectTimeout = natsConnect
	cfg.NATSFlushTimeout = natsFlush
	cfg.NATSDrainTimeout = natsDrain
	if cfg.NATSURL == "" {
		return Config{}, errors.New("NATS_URL is required")
	}
{{end}}{{if .Options.HasSession}}	secure, err := boolEnv(getenv, "AUTH_SESSION_SECURE", {{if .Options.IsProduction}}true{{else}}false{{end}})
	if err != nil { return Config{}, err }
	ttl, err := durationEnv(getenv, "AUTH_SESSION_TTL", 24*time.Hour)
	if err != nil { return Config{}, err }
	idleTimeout, err := durationEnv(getenv, "AUTH_SESSION_IDLE_TIMEOUT", 2*time.Hour)
	if err != nil { return Config{}, err }
	memoryKiB, err := intEnv(getenv, "AUTH_PASSWORD_ARGON2_MEMORY_KIB", 19456)
	if err != nil { return Config{}, err }
	argonTime, err := intEnv(getenv, "AUTH_PASSWORD_ARGON2_TIME", 2)
	if err != nil { return Config{}, err }
	parallelism, err := intEnv(getenv, "AUTH_PASSWORD_ARGON2_PARALLELISM", 1)
	if err != nil { return Config{}, err }
	hashConcurrency, err := intEnv(getenv, "AUTH_PASSWORD_HASH_CONCURRENCY", 4)
	if err != nil { return Config{}, err }
	loginRateLimit, err := intEnv(getenv, "AUTH_LOGIN_RATE_LIMIT", 5)
	if err != nil { return Config{}, err }
	loginRateWindow, err := durationEnv(getenv, "AUTH_LOGIN_RATE_WINDOW", 15*time.Minute)
	if err != nil { return Config{}, err }
	auditRetentionDays, err := intEnv(getenv, "AUTH_AUDIT_RETENTION_DAYS", 0)
	if err != nil { return Config{}, err }
	if auditRetentionDays < 0 || auditRetentionDays > 36500 {
		return Config{}, errors.New("AUTH_AUDIT_RETENTION_DAYS must be between 0 (disabled) and 36500")
	}
	if ttl <= 0 || ttl > 30*24*time.Hour {
		return Config{}, errors.New("AUTH_SESSION_TTL must be greater than zero and at most 720h")
	}
	if idleTimeout <= 0 || idleTimeout > ttl {
		return Config{}, errors.New("AUTH_SESSION_IDLE_TIMEOUT must be greater than zero and at most AUTH_SESSION_TTL")
	}
	if !validArgon2Config(memoryKiB, argonTime, parallelism) {
		return Config{}, errors.New("Argon2id parameters must match or dominate an OWASP published configuration: m=47104,t=1,p=1; m=19456,t=2,p=1; m=12288,t=3,p=1; m=9216,t=4,p=1; m=7168,t=5,p=1")
	}
	if hashConcurrency < 1 || hashConcurrency > 64 {
		return Config{}, errors.New("AUTH_PASSWORD_HASH_CONCURRENCY must be between 1 and 64")
	}
	if loginRateLimit < 1 || loginRateLimit > 1000 {
		return Config{}, errors.New("AUTH_LOGIN_RATE_LIMIT must be between 1 and 1000")
	}
	if loginRateWindow <= 0 || loginRateWindow > 24*time.Hour {
		return Config{}, errors.New("AUTH_LOGIN_RATE_WINDOW must be greater than zero and at most 24h")
	}
{{if .Options.IsProduction}}	if !secure {
		return Config{}, errors.New("AUTH_SESSION_SECURE must be true for the production profile")
	}
{{end}}	bootstrapEmail := strings.TrimSpace(getenv("AUTH_BOOTSTRAP_EMAIL"))
	bootstrapPassword := getenv("AUTH_BOOTSTRAP_PASSWORD")
	if (bootstrapEmail == "") != (bootstrapPassword == "") {
		return Config{}, errors.New("AUTH_BOOTSTRAP_EMAIL and AUTH_BOOTSTRAP_PASSWORD must both be set or both be empty")
	}
	cfg.AuthSessionSecure = secure
	cfg.AuthSessionTTL = ttl
	cfg.AuthSessionIdleTimeout = idleTimeout
	cfg.AuthPasswordArgon2MemoryKiB = uint32(memoryKiB)
	cfg.AuthPasswordArgon2Time = uint32(argonTime)
	cfg.AuthPasswordArgon2Parallelism = uint8(parallelism)
	cfg.AuthPasswordHashConcurrency = hashConcurrency
	cfg.AuthLoginRateLimit = loginRateLimit
	cfg.AuthLoginRateWindow = loginRateWindow
	cfg.AuthAuditRetentionDays = auditRetentionDays
	cfg.AuthBootstrapEmail = bootstrapEmail
	cfg.AuthBootstrapPassword = bootstrapPassword
	if len(cfg.CORSOrigins) > 0 {
		cfg.Warnings = append(cfg.Warnings, "CORS_ORIGINS is set while session authentication rejects cross-origin browser writes; use a same-origin development proxy")
	}
{{end}}{{if .Options.HasJWT}}	secret, err := decodeJWTSecret(getenv("AUTH_JWT_SECRET_B64"))
	if err != nil {
		return Config{}, err
	}
	leeway, err := durationEnv(getenv, "AUTH_JWT_LEEWAY", 30*time.Second)
	if err != nil {
		return Config{}, err
	}
	if leeway < 0 {
		return Config{}, errors.New("AUTH_JWT_LEEWAY cannot be negative")
	}
	if leeway > 2*time.Minute {
		return Config{}, errors.New("AUTH_JWT_LEEWAY must be at most 2m")
	}
	cfg.AuthJWTSecret = secret
	cfg.AuthJWTIssuer = strings.TrimSpace(getenv("AUTH_JWT_ISSUER"))
	cfg.AuthJWTAudience = strings.TrimSpace(getenv("AUTH_JWT_AUDIENCE"))
	cfg.AuthJWTLeeway = leeway
	if cfg.AuthJWTIssuer == "" {
		return Config{}, errors.New("AUTH_JWT_ISSUER is required")
	}
	if cfg.AuthJWTAudience == "" {
		return Config{}, errors.New("AUTH_JWT_AUDIENCE is required")
	}
{{end}}	return cfg, nil
}

func intEnv(getenv envLookup, name string, fallback int) (int, error) {
	raw := strings.TrimSpace(getenv(name))
	if raw == "" {
		return fallback, nil
	}
	value, err := strconv.Atoi(raw)
	if err != nil {
		return 0, errors.New(name + " must be an integer")
	}
	return value, nil
}

func durationEnv(getenv envLookup, name string, fallback time.Duration) (time.Duration, error) {
	raw := strings.TrimSpace(getenv(name))
	if raw == "" {
		return fallback, nil
	}
	value, err := time.ParseDuration(raw)
	if err != nil {
		return 0, errors.New(name + " must be a Go duration")
	}
	return value, nil
}

{{if .Options.HasSession}}func boolEnv(getenv envLookup, name string, fallback bool) (bool, error) {
	raw := strings.TrimSpace(getenv(name))
	if raw == "" { return fallback, nil }
	value, err := strconv.ParseBool(raw)
	if err != nil { return false, errors.New(name + " must be a boolean") }
	return value, nil
}

func validArgon2Config(memoryKiB, iterations, parallelism int) bool {
	if memoryKiB < 7168 || memoryKiB > 65536 || iterations < 1 || iterations > 10 || parallelism < 1 || parallelism > 16 {
		return false
	}
	recommended := [][3]int{[3]int{47104, 1, 1}, [3]int{19456, 2, 1}, [3]int{12288, 3, 1}, [3]int{9216, 4, 1}, [3]int{7168, 5, 1}}
	for _, candidate := range recommended {
		if memoryKiB >= candidate[0] && iterations >= candidate[1] && parallelism >= candidate[2] { return true }
	}
	return false
}
{{end}}func envOr(getenv envLookup, name, fallback string) string {
	if value := getenv(name); value != "" {
		return value
	}
	return fallback
}
{{if .Options.HasJWT}}
func decodeJWTSecret(raw string) ([]byte, error) {
	raw = strings.TrimSpace(raw)
	if raw == "" {
		return nil, errors.New("AUTH_JWT_SECRET_B64 is required")
	}
	secret, err := base64.StdEncoding.DecodeString(raw)
	if err != nil {
		return nil, errors.New("AUTH_JWT_SECRET_B64 must be standard base64")
	}
	if len(secret) < 32 {
		return nil, errors.New("AUTH_JWT_SECRET_B64 must decode to at least 32 bytes")
	}
	return secret, nil
}
