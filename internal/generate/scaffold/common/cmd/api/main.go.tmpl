package main

import (
	"context"
	"log/slog"
	"os"
	"os/signal"
	"syscall"
	"time"
{{if .Options.HasSession}}	"sync"
{{end}}
{{if .Options.IsEcho}}
	"errors"
	"net/http"
{{end}}

	"{{.Module}}/internal/app"
	"{{.Module}}/internal/platform/config"
	"{{.Module}}/internal/platform/database"
	"{{.Module}}/internal/platform/logging"
{{if .Options.IsProduction}}	"{{.Module}}/internal/platform/observability"
{{end}}
{{if .Options.HasJWT}}	"{{.Module}}/internal/platform/auth"
{{end}}{{if .Options.HasSession}}	"{{.Module}}/internal/platform/auth"
	"{{.Module}}/internal/platform/audit"
{{end}}{{if .Options.HasRedis}}	"{{.Module}}/internal/platform/cache"
{{end}}{{if .Options.HasNATS}}	"{{.Module}}/internal/platform/messaging"
{{end}})

func main() { os.Exit(run()) }

func run() (exitCode int) {
	logger, flush, err := logging.New()
	if err != nil {
		_, _ = os.Stderr.WriteString("logger initialization failed\n")
		return 1
	}
	slog.SetDefault(logger)
	defer func() {
		if err := flush(); err != nil {
			logger.Error("log flush failed", "error", err)
			exitCode = 1
		}
	}()

	signals := make(chan os.Signal, 1)
	signal.Notify(signals, syscall.SIGINT, syscall.SIGTERM)
	defer signal.Stop(signals)

	cfg, err := config.Load()
	if err != nil {
		logger.Error("invalid configuration", "error", err)
		return 1
	}
{{if .Options.HasSession}}	for _, warning := range cfg.Warnings {
		logger.Warn("configuration warning", "warning", warning)
	}
	runContext, cancelRun := context.WithCancel(context.Background())
	defer cancelRun()
{{end}}
{{if .Options.IsProduction}}	logger = logger.With(
		slog.String("service", cfg.ServiceName),
		slog.String("environment", cfg.Environment),
		slog.String("version", cfg.BuildVersion),
	)
	slog.SetDefault(logger)
{{end}}
{{if .Options.IsPostgres}}	startupContext, cancelStartup := context.WithTimeout({{if .Options.HasSession}}runContext{{else}}context.Background(){{end}}, cfg.DatabaseConnectTimeout)
	connection, err := database.Open(startupContext, cfg.DatabaseURL, database.PoolOptions{
		MaxOpenConnections:    cfg.DatabaseMaxOpenConnections,
		MaxIdleConnections:    cfg.DatabaseMaxIdleConnections,
		ConnectionMaxLifetime: cfg.DatabaseConnectionMaxLifetime,
		ConnectionMaxIdleTime: cfg.DatabaseConnectionMaxIdleTime,
	})
	cancelStartup()
{{else}}	startupContext, cancelStartup := context.WithTimeout({{if .Options.HasSession}}runContext{{else}}context.Background(){{end}}, cfg.DatabaseConnectTimeout)
	connection, err := database.Open(startupContext, cfg.DatabasePath)
	cancelStartup()
{{end}}	if err != nil {
		logger.Error("database connection failed", "error", err)
		return 1
	}
	defer func() {
		if err := connection.Close(); err != nil {
			logger.Error("database close failed", "error", err)
			exitCode = 1
		}
	}()
{{if .Options.HasSession}}
	passwords, err := auth.NewPasswordManager(auth.PasswordParams{
		MemoryKiB: cfg.AuthPasswordArgon2MemoryKiB, Time: cfg.AuthPasswordArgon2Time,
		Parallelism: cfg.AuthPasswordArgon2Parallelism,
	}, cfg.AuthPasswordHashConcurrency)
	if err != nil {
		logger.Error("password manager construction failed", "error", err)
		return 1
	}
	authStore := auth.NewStore(connection.ORM)
	created, ignored, err := authStore.Bootstrap(runContext, cfg.AuthBootstrapEmail, cfg.AuthBootstrapPassword, passwords)
	if err != nil {
		logger.Error("session authentication bootstrap failed", "error", err)
		return 1
	}
	if created {
		logger.Warn("bootstrap administrator created; remove AUTH_BOOTSTRAP_EMAIL and AUTH_BOOTSTRAP_PASSWORD, then rotate the password immediately")
	}
	if ignored {
		logger.Warn("bootstrap credentials ignored because an auth user already exists; remove AUTH_BOOTSTRAP_EMAIL and AUTH_BOOTSTRAP_PASSWORD")
	}
	var authWorkers sync.WaitGroup
	if cfg.AuthAuditRetentionDays > 0 {
		authWorkers.Go(func() {
			audit.NewStore(connection.ORM, logger).SweepRetention(runContext, cfg.AuthAuditRetentionDays)
		})
	}
	authWorkers.Go(func() {
		authStore.SweepExpired(runContext, time.Hour, func(err error) {
			logger.Error("session expiry sweep failed", "error", err)
		})
	})
	defer func() {
		cancelRun()
		authWorkers.Wait()
	}()
{{end}}
{{if .Options.IsProduction}}
	metrics := observability.New(connection.SQL)
{{end}}
{{if .Options.HasRedis}}
	redisContext, cancelRedis := context.WithTimeout(context.Background(), cfg.RedisConnectTimeout)
	redisClient, err := cache.Open(redisContext, cfg.RedisURL)
	cancelRedis()
	if err != nil {
		logger.Error("redis connection failed", "error", err)
		return 1
	}
	defer func() {
		if err := redisClient.Close(); err != nil {
			logger.Error("redis close failed", "error", err)
			exitCode = 1
		}
	}()
{{end}}{{if .Options.HasNATS}}
	natsConn, err := messaging.Connect(cfg.NATSURL, cfg.NATSConnectTimeout, cfg.NATSFlushTimeout, cfg.NATSDrainTimeout)
	if err != nil {
		logger.Error("nats connection failed", "error", err)
		return 1
	}
	defer func() {
		if err := messaging.Drain(natsConn, cfg.NATSDrainTimeout); err != nil {
			logger.Error("nats drain failed", "error", err)
			exitCode = 1
		}
	}()
{{end}}{{if .Options.HasJWT}}
	verifier, err := auth.NewVerifier(cfg.AuthJWTSecret, cfg.AuthJWTIssuer, cfg.AuthJWTAudience, cfg.AuthJWTLeeway)
	if err != nil {
		logger.Error("jwt verifier construction failed", "error", err)
		return 1
	}
{{end}}
{{if .Options.IsEcho}}	handler := app.New(cfg, connection.ORM, logger{{if .Options.IsProduction}}, metrics{{end}}{{if .Options.HasJWT}}, verifier{{end}}{{if .Options.HasSession}}, authStore, passwords{{end}}{{if .Options.HasRedis}}, redisClient{{end}}{{if .Options.HasNATS}}, natsConn{{end}})
	server := &http.Server{
		Addr:              cfg.Address,
		Handler:           handler,
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       20 * time.Second,
		WriteTimeout:      20 * time.Second,
		IdleTimeout:       60 * time.Second,
	}
	serverErrors := make(chan error, 1)
	go func() {
		logger.Info("server starting", "address", cfg.Address)
		serverErrors <- server.ListenAndServe()
	}()
	select {
	case sig := <-signals:
		logger.Info("shutdown requested", "signal", sig.String())
	case err := <-serverErrors:
		if !errors.Is(err, http.ErrServerClosed) {
			logger.Error("server stopped", "error", err)
			exitCode = 1
		}
	}
{{if .Options.HasSession}}	cancelRun()
	authWorkers.Wait()
{{end}}	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := server.Shutdown(ctx); err != nil {
		logger.Error("graceful shutdown failed", "error", err)
		exitCode = 1
	}
{{else}}	fiberApp := app.New(cfg, connection.ORM, logger{{if .Options.IsProduction}}, metrics{{end}}{{if .Options.HasJWT}}, verifier{{end}}{{if .Options.HasRedis}}, redisClient{{end}}{{if .Options.HasNATS}}, natsConn{{end}})
	serverErrors := make(chan error, 1)
	go func() {
		logger.Info("server starting", "address", cfg.Address)
		serverErrors <- fiberApp.Listen(cfg.Address)
	}()
	select {
	case sig := <-signals:
		logger.Info("shutdown requested", "signal", sig.String())
	case err := <-serverErrors:
		if err != nil {
			logger.Error("server stopped", "error", err)
			exitCode = 1
		}
	}
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := fiberApp.ShutdownWithContext(ctx); err != nil {
		logger.Error("graceful shutdown failed", "error", err)
		exitCode = 1
	}
{{end}}	return exitCode
}
