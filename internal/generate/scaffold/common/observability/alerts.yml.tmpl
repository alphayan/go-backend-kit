groups:
  - name: generated-api
    rules:
      - alert: GeneratedAPIHighErrorRate
        expr: |
          sum(rate(http_server_requests_total{status_class="5xx"}[5m]))
          /
          clamp_min(sum(rate(http_server_requests_total[5m])), 1) > 0.05
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: Generated API has a high HTTP 5xx rate

      - alert: GeneratedAPIHighLatency
        expr: |
          histogram_quantile(0.95,
            sum by (le) (rate(http_server_request_duration_seconds_bucket[5m]))) > 1
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: Generated API p95 latency is above one second

      - alert: GeneratedAPIDatabasePoolWaiting
        expr: rate(db_wait_count[5m]) > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: Requests are waiting for database connections
