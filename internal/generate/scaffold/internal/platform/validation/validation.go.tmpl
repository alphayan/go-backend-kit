package validation

import (
	"fmt"
	"math"

	"github.com/shopspring/decimal"
)

type Details map[string]string

func Presence(details Details, name string, set, null, required, nullable bool) {
	if required && !set {
		details[name] = "is required"
		return
	}
	if null && !nullable {
		details[name] = "cannot be null"
	}
}

func MaxLength(details Details, name, value string, limit int) {
	if len([]rune(value)) > limit {
		details[name] = fmt.Sprintf("must be at most %d characters", limit)
	}
}

func OneOf(details Details, name, value string, allowed []string) {
	for _, candidate := range allowed {
		if value == candidate {
			return
		}
	}
	details[name] = "must be one of the allowed values"
}

func Min(details Details, name string, value any, minimum string) {
	if number, ok := asDecimal(value); ok && number.LessThan(decimal.RequireFromString(minimum)) {
		details[name] = fmt.Sprintf("must be at least %s", minimum)
	}
}

func Max(details Details, name string, value any, maximum string) {
	if number, ok := asDecimal(value); ok && number.GreaterThan(decimal.RequireFromString(maximum)) {
		details[name] = fmt.Sprintf("must be at most %s", maximum)
	}
}

func asDecimal(value any) (decimal.Decimal, bool) {
	switch value := value.(type) {
	case int32:
		return decimal.NewFromInt(int64(value)), true
	case int64:
		return decimal.NewFromInt(value), true
	case float64:
		if math.IsNaN(value) || math.IsInf(value, 0) {
			return decimal.Decimal{}, false
		}
		return decimal.NewFromFloat(value), true
	case decimal.Decimal:
		return value, true
	default:
		return decimal.Decimal{}, false
	}
}
